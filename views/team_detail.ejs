<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <%- include('partials/flash') %>

  <!-- Team Header -->
  <div class="glass-panel p-6 sm:p-8 flex flex-col md:flex-row items-center md:items-start gap-6 border-orange-500/20">
    <div class="relative shrink-0 group/logo">
      <img id="teamMainLogo" src="<%= team.logo_url %>" alt="<%= team.name %>" class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl object-cover bg-slate-800 border-2 border-orange-500/40 shadow-xl" onerror="this.src='https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=200&auto=format&fit=crop'">
      
      <% if (isAdmin) { %>
        <button 
          type="button" 
          onclick="document.getElementById('teamQuickLogoModal').classList.remove('hidden')"
          class="absolute inset-0 bg-black/60 rounded-2xl opacity-0 group-hover/logo:opacity-100 flex flex-col items-center justify-center transition-opacity text-white text-xs font-bold p-2 text-center"
          title="Upload / Change Logo"
        >
          <svg class="w-6 h-6 text-orange-400 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
          Change Logo
        </button>
      <% } %>
    </div>
    
    <div class="space-y-3 text-center md:text-left flex-1">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-2">
        <a href="/teams" class="text-xs font-mono text-slate-400 hover:text-orange-400">&larr; Back to Teams</a>
        <span class="text-slate-600">•</span>
        <span class="badge-official font-mono">[<%= team.tag %>]</span>
        <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-white/10 text-slate-300"><%= team.country %></span>
        <% if (isAdmin) { %>
          <button 
            type="button"
            onclick="document.getElementById('teamQuickLogoModal').classList.remove('hidden')"
            class="btn-glass text-xs py-0.5 px-2 text-orange-400 hover:text-white"
          >
            Edit Logo
          </button>
        <% } %>
      </div>

      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white tracking-wide leading-none">
        <%= team.name %>
      </h1>

      <p class="text-sm text-slate-400">
        Professional Free Fire MAX Squad Organization.
      </p>
    </div>
  </div>

  <!-- Roster Section with Player Cards -->
  <section class="space-y-6">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-3xl font-bold text-white tracking-wide">Active Squad Roster</h2>
      <span class="badge-official"><%= roster.length %> Players</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% roster.forEach(p => { %>
        <div class="player-card glass-card p-6 flex flex-col justify-between group">
          <div>
            <div class="flex items-start gap-4 mb-4">
              <img src="<%= p.avatar_url %>" alt="<%= p.in_game_name %>" class="w-16 h-16 rounded-2xl object-cover border-2 border-orange-500/30 group-hover:border-orange-500 shadow-md bg-slate-800" onerror="this.src='https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=300&auto=format&fit=crop'">
              <div class="flex-1 min-w-0">
                <a href="/player/<%= p.player_id %>" class="font-display text-2xl font-bold text-white group-hover:text-orange-400 transition-colors truncate block">
                  <%= p.in_game_name %>
                </a>
                <p class="text-xs text-slate-400"><%= p.player_name %></p>
                <span class="px-2 py-0.5 rounded bg-white/10 text-[11px] font-mono text-slate-300 mt-1 inline-block">
                  <%= p.role %>
                </span>
              </div>
            </div>

            <!-- Stats Dual-Tab Toggle Controls -->
            <div class="p-1 rounded-xl bg-black/40 border border-white/10 flex gap-1 mb-4">
              <button type="button" class="touch-manipulation select-none player-stat-tab-btn flex-1 py-2 px-2 rounded-lg text-xs font-mono font-bold flex items-center justify-center gap-1.5 transition-all duration-200 cursor-pointer active:scale-95 bg-emerald-500/20 text-emerald-300 border border-emerald-400/50" data-target="official">
                <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Official Stats
              </button>
              <button type="button" class="touch-manipulation select-none player-stat-tab-btn flex-1 py-2 px-2 rounded-lg text-xs font-mono font-bold flex items-center justify-center gap-1.5 transition-all duration-200 cursor-pointer active:scale-95 bg-black/20 text-gray-400 border border-transparent" data-target="unofficial">
                <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                Unofficial / Live Stats
              </button>
            </div>

            <!-- 1. OFFICIAL STATS TAB -->
            <div class="player-stats-official space-y-3">
              <div class="grid grid-cols-2 gap-2">
                <div class="stat-box border-emerald-500/20 bg-black/40">
                  <div class="stat-box-value text-emerald-400"><%= p.official.kills %></div>
                  <div class="stat-box-label">Total Kills</div>
                </div>
                <div class="stat-box border-emerald-500/20 bg-black/40">
                  <div class="stat-box-value text-white"><%= p.official.total_points %></div>
                  <div class="stat-box-label">Total Points</div>
                </div>
                <div class="stat-box border-emerald-500/20 bg-black/40">
                  <div class="stat-box-value text-emerald-300">#<%= p.official.avg_placement %></div>
                  <div class="stat-box-label">Avg Placement</div>
                </div>
                <div class="stat-box border-emerald-500/20 bg-black/40">
                  <div class="stat-box-value text-gray-200"><%= p.official.matches_played %></div>
                  <div class="stat-box-label">Matches Played</div>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-2 text-xs font-mono bg-gray-900/40 p-2.5 rounded-lg border border-white/5">
                <div>
                  <span class="text-gray-400">Avg Kills:</span>
                  <span class="font-bold text-emerald-300 ml-1"><%= p.official.avg_kills %></span>
                </div>
                <div>
                  <span class="text-gray-400">Avg DMG:</span>
                  <span class="font-bold text-white ml-1"><%= p.official.avg_damage %></span>
                </div>
                <div>
                  <span class="text-gray-400">Headshots:</span>
                  <span class="font-bold text-amber-400 ml-1"><%= p.official.headshots %></span>
                </div>
                <div>
                  <span class="text-gray-400">Status:</span>
                  <span class="font-bold text-emerald-400 ml-1">Verified</span>
                </div>
              </div>
            </div>

            <!-- 2. UNOFFICIAL / LIVE STATS TAB (HIDDEN BY DEFAULT) -->
            <div class="player-stats-unofficial space-y-3 hidden">
              <% if (p.unofficial.has_stats) { %>
                <div class="grid grid-cols-2 gap-2">
                  <div class="stat-box border-amber-500/20 bg-black/40">
                    <div class="stat-box-value text-amber-400"><%= p.unofficial.kills %></div>
                    <div class="stat-box-label">Total Kills</div>
                  </div>
                  <div class="stat-box border-amber-500/20 bg-black/40">
                    <div class="stat-box-value text-white"><%= p.unofficial.total_points %></div>
                    <div class="stat-box-label">Total Points</div>
                  </div>
                  <div class="stat-box border-amber-500/20 bg-black/40">
                    <div class="stat-box-value text-amber-300">#<%= p.unofficial.avg_placement %></div>
                    <div class="stat-box-label">Avg Placement</div>
                  </div>
                  <div class="stat-box border-amber-500/20 bg-black/40">
                    <div class="stat-box-value text-gray-200"><%= p.unofficial.matches_played %></div>
                    <div class="stat-box-label">Matches Played</div>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-2 text-xs font-mono bg-gray-900/40 p-2.5 rounded-lg border border-white/5">
                  <div>
                    <span class="text-gray-400">Avg Kills:</span>
                    <span class="font-bold text-amber-300 ml-1"><%= p.unofficial.avg_kills %></span>
                  </div>
                  <div>
                    <span class="text-gray-400">Avg DMG:</span>
                    <span class="font-bold text-white ml-1"><%= p.unofficial.avg_damage %></span>
                  </div>
                  <div>
                    <span class="text-gray-400">Headshots:</span>
                    <span class="font-bold text-amber-400 ml-1"><%= p.unofficial.headshots %></span>
                  </div>
                  <div>
                    <span class="text-gray-400">Status:</span>
                    <span class="font-bold text-amber-400 ml-1">Live/Provisional</span>
                  </div>
                </div>
              <% } else { %>
                <!-- Unavailable / Pending Placeholder -->
                <div class="p-5 rounded-xl bg-black/40 border border-white/10 text-center space-y-2">
                  <div class="w-10 h-10 rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center mx-auto border border-amber-500/20">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  </div>
                  <h4 class="font-display text-lg font-bold text-gray-200">Unofficial Data Pending</h4>
                  <p class="text-xs text-gray-400 leading-relaxed">
                    No unconfirmed live stream stats recorded. All current matches for this player are 100% verified official.
                  </p>
                </div>
              <% } %>
            </div>
          </div>

          <div class="pt-4 mt-4 border-t border-white/10">
            <a href="/player/<%= p.player_id %>" class="btn-glass text-xs w-full justify-center">
              View Detailed Player Career
            </a>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <% if (isAdmin) { %>
    <!-- Quick Team Logo Upload Modal for Admins -->
    <div id="teamQuickLogoModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
      <div class="glass-panel max-w-md w-full p-6 space-y-6 border border-orange-500/30 relative animate-smooth-in shadow-2xl bg-slate-950">
        
        <button type="button" onclick="document.getElementById('teamQuickLogoModal').classList.add('hidden')" class="absolute top-4 right-4 text-slate-400 hover:text-white text-2xl font-bold w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/10 transition-colors">
          &times;
        </button>

        <div class="border-b border-white/10 pb-3">
          <h3 class="font-display text-2xl font-bold text-white flex items-center gap-2">
            <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Update Team Crest / Logo
          </h3>
          <p class="text-xs text-slate-400 mt-1">Upload a new crest for <span class="text-white font-bold"><%= team.name %></span></p>
        </div>

        <form action="/admin/teams/<%= team.id %>/logo" method="POST" enctype="multipart/form-data" class="space-y-4">
          <input type="hidden" name="redirect_to" value="/team/<%= team.id %>">
          
          <div class="p-4 rounded-xl bg-slate-900/90 border border-orange-500/20 space-y-3">
            <div class="flex items-center gap-4">
              <img id="detailTeamModalPreview" src="<%= team.logo_url %>" alt="Preview" class="w-20 h-20 rounded-2xl object-cover border-2 border-orange-500/50 shadow-md bg-slate-800" onerror="this.src='https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=200&auto=format&fit=crop'">
              <div class="flex-1 space-y-2">
                <label class="btn-fire w-full cursor-pointer text-xs py-2.5 justify-center flex items-center gap-2">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <span id="detailTeamFileName">Choose Logo File</span>
                  <input type="file" name="logo" accept="image/*" class="hidden" onchange="previewTeamDetailLogo(this)">
                </label>
                <p class="text-[11px] font-mono text-slate-400">Sharp WebP auto-compressed.</p>
              </div>
            </div>

            <div>
              <label for="detail_logo_url" class="block text-[11px] font-mono text-slate-400 mb-1">Or Logo URL:</label>
              <input 
                type="text" 
                id="detail_logo_url" 
                name="logo_url" 
                placeholder="https://..." 
                class="w-full px-3 py-1.5 rounded-lg bg-black/40 border border-white/10 text-white text-xs font-mono placeholder-slate-600 focus:outline-none focus:border-orange-500"
                oninput="document.getElementById('detailTeamModalPreview').src = this.value || '<%= team.logo_url %>'"
              >
            </div>
          </div>

          <div class="flex items-center gap-3 pt-2">
            <button type="button" onclick="document.getElementById('teamQuickLogoModal').classList.add('hidden')" class="btn-glass flex-1 py-2.5 text-xs">
              Cancel
            </button>
            <button type="submit" class="btn-fire flex-1 py-2.5 text-xs">
              Save Logo
            </button>
          </div>
        </form>

      </div>
    </div>

    <script>
      function previewTeamDetailLogo(input) {
        if (input.files && input.files[0]) {
          const file = input.files[0];
          const reader = new FileReader();
          reader.onload = function(e) {
            document.getElementById('detailTeamModalPreview').src = e.target.result;
          };
          reader.readAsDataURL(file);
          document.getElementById('detailTeamFileName').textContent = file.name.length > 18 ? file.name.substring(0, 15) + '...' : file.name;
        }
      }
    </script>
  <% } %>

</main>

<%- include('partials/footer') %>
