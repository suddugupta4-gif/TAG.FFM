<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  
  <%- include('partials/flash') %>

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white tracking-wide">Tournament Archives</h1>
      <p class="text-gray-400 text-sm">Explore past and active Free Fire MAX esports championships, seasons, and invitationals.</p>
    </div>
    <% if (isAdmin) { %>
      <div class="flex items-center gap-2">
        <a href="<%= adminHref('/admin/tournaments/new') %>" class="btn-fire text-xs py-2.5 px-4 flex items-center gap-2 font-bold shadow-lg shadow-orange-950/40">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          <span>+ Create Tournament</span>
        </a>
        <a href="<%= adminHref('/admin/tournaments') %>" class="btn-glass text-xs py-2.5 px-4 flex items-center gap-1.5 text-slate-300 hover:text-white font-bold">
          <span>Manage Tournaments &rarr;</span>
        </a>
      </div>
    <% } %>
  </div>

  <!-- Tournaments Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% tournaments.forEach(t => { %>
      <div class="glass-card overflow-hidden flex flex-col group <%= t.is_current ? 'border-[#ff4e00]/40 ring-1 ring-[#ff4e00]/25' : '' %>">
        <!-- Banner -->
        <div class="relative h-48 overflow-hidden bg-[#050508]">
          <img src="<%= t.banner_url %>" alt="<%= t.name %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 opacity-80 group-hover:opacity-100" onerror="this.src='https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=800&auto=format&fit=crop'">
          <div class="absolute inset-0 bg-gradient-to-t from-[#050508] via-[#050508]/40 to-transparent"></div>
          
          <div class="absolute top-3 left-3 flex gap-2">
            <% if (t.is_current) { %>
              <span class="badge-live">
                <span class="live-dot"></span>
                CURRENT
              </span>
            <% } else { %>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-mono bg-black/60 border border-white/10 text-gray-300">
                <%= t.status === 'completed' ? 'ARCHIVED' : 'UPCOMING' %>
              </span>
            <% } %>
          </div>

          <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
            <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-black/60 backdrop-blur-md text-slate-300 border border-white/10 font-bold">
              <%= t.circuit_type === 'official' ? 'Official Esports' : 'Community Cup' %>
            </span>
            <span class="text-xs font-mono text-gray-400">
              <%= t.game_mode %>
            </span>
          </div>
        </div>

        <!-- Content -->
        <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
          <div>
            <h2 class="font-display text-2xl font-bold text-white group-hover:text-[#ff4e00] transition-colors">
              <a href="/tournament/<%= t.id %>"><%= t.name %></a>
            </h2>
            <p class="text-xs text-gray-400 line-clamp-2 mt-1">
              <%= t.description || 'Championship Free Fire MAX tournament.' %>
            </p>
          </div>

          <div class="pt-3 border-t border-white/5 flex items-center justify-between gap-2">
            <span class="text-xs font-mono text-gray-500">
              <%= t.start_date ? new Date(t.start_date).toLocaleDateString() : 'Active' %>
            </span>
            <div class="flex items-center gap-1.5">
              <% if (isAdmin) { %>
                <a href="<%= adminHref('/admin/tournaments/' + t.id + '/edit') %>" class="btn-fire text-[11px] py-1 px-2.5" title="Manage Tournament & Matches">
                  Manage
                </a>
              <% } %>
              <a href="/tournament/<%= t.id %>" class="btn-glass text-xs py-1.5 px-3">
                View Standings &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  </div>

</main>

<%- include('partials/footer') %>
