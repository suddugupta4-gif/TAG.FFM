<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title><%= typeof title !== 'undefined' ? title : 'TAGFREEFIREMAX — Free Fire MAX Esports Tournament Tracker' %></title>
  
  <!-- Google Site Verification -->
  <meta name="google-site-verification" content="XwwKp8c9rGEIboQUHE_AQeP7sw0L_3nSAVgnuSLAG7I">
  <meta name="google-site-verification" content="_kWbwASv7kgV_SDw6Z8ds7zVk-DEAYeHBeUzh2qhWNs">
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="alternate icon" href="/favicon.svg">
  
  <!-- Google Fonts: Teko (Esports Display), Rajdhani (Sharp Gaming), Outfit (Clean Modern UI), JetBrains Mono (Tech Data) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Outfit:wght@300;400;500;600;700;800;900&family=Rajdhani:wght@500;600;700;800&family=Teko:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            ffprimary: '#ff4e00',
            ffgold: '#f59e0b',
            ffemerald: '#10b981',
            ffcyan: '#06b6d4'
          },
          fontFamily: {
            display: ['Teko', 'Rajdhani', 'Impact', 'sans-serif'],
            body: ['Outfit', 'system-ui', '-apple-system', 'Segoe UI', 'Roboto', 'sans-serif'],
            mono: ['JetBrains Mono', 'Courier New', 'monospace']
          }
        }
      }
    }
  </script>

  <!-- External Stylesheet with fallback -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Embedded Guaranteed Stylesheet (Runs even if static assets fail on serverless) -->
  <style>
    :root {
      --ff-font-display: 'Teko', 'Rajdhani', 'Impact', sans-serif;
      --ff-font-body: 'Outfit', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --ff-font-mono: 'JetBrains Mono', monospace;
      --ff-primary: #ff4e00;
      --ff-gold: #f59e0b;
      --ff-emerald: #10b981;
      --ff-cyan: #06b6d4;
      --canvas-bg: #050508;
      --glass-bg: rgba(18, 20, 32, 0.75);
      --glass-border: rgba(255, 255, 255, 0.14);
    }

    * { box-sizing: border-box; }

    body {
      font-family: var(--ff-font-body);
      background-color: var(--canvas-bg);
      color: #f3f4f6;
      min-height: 100vh;
      position: relative;
      overflow-x: hidden;
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    /* Ambient Lighting */
    .site-ambient-glow {
      position: fixed;
      top: 0;
      right: 0;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(255, 78, 0, 0.08) 0%, transparent 70%);
      border-radius: 9999px;
      filter: blur(100px);
      pointer-events: none;
      z-index: -1;
    }

    .site-ambient-glow-bottom {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(16, 185, 129, 0.05) 0%, transparent 70%);
      border-radius: 9999px;
      filter: blur(120px);
      pointer-events: none;
      z-index: -1;
    }

    /* Background Wallpaper Layer */
    .site-bg-layer {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -2;
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      filter: brightness(0.65) saturate(1.15);
      transform: scale(1.01);
      transition: background-image 0.5s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
    }

    .site-bg-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      z-index: -2;
      background: radial-gradient(circle at top center, rgba(255, 78, 0, 0.05) 0%, rgba(5, 5, 8, 0.35) 45%, rgba(5, 5, 8, 0.72) 100%);
      pointer-events: none;
    }

    /* Typography */
    .font-display {
      font-family: var(--ff-font-display) !important;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      font-feature-settings: "cv02", "cv03", "cv04", "cv11";
    }

    .font-mono {
      font-family: var(--ff-font-mono) !important;
    }

    /* Text Glow Utilities */
    .text-glow {
      text-shadow: 0 0 16px rgba(255, 78, 0, 0.6), 0 0 30px rgba(255, 78, 0, 0.25);
    }
    .text-glow-gold {
      text-shadow: 0 0 16px rgba(245, 158, 11, 0.6), 0 0 30px rgba(245, 158, 11, 0.25);
    }
    .text-glow-emerald {
      text-shadow: 0 0 16px rgba(16, 185, 129, 0.6), 0 0 30px rgba(16, 185, 129, 0.25);
    }
    .text-glow-cyan {
      text-shadow: 0 0 16px rgba(6, 182, 212, 0.6), 0 0 30px rgba(6, 182, 212, 0.25);
    }

    /* Frosted Glass System */
    .glass {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(18, 20, 32, 0.78) 100%) !important;
      backdrop-filter: blur(20px) saturate(180%) !important;
      -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
      border: 1px solid var(--glass-border) !important;
      box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45), inset 0 1px 0 0 rgba(255, 255, 255, 0.14) !important;
    }

    .glass-card, .tournament-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(18, 20, 32, 0.72) 100%) !important;
      backdrop-filter: blur(18px) saturate(160%) !important;
      -webkit-backdrop-filter: blur(18px) saturate(160%) !important;
      border: 1px solid rgba(255, 255, 255, 0.13) !important;
      border-radius: 1.1rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.42), inset 0 1px 0 0 rgba(255, 255, 255, 0.12);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .glass-card:hover, .tournament-card:hover {
      transform: translateY(-2px);
      border-color: rgba(255, 78, 0, 0.5) !important;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.55), 0 0 20px rgba(255, 78, 0, 0.18), inset 0 1px 0 0 rgba(255, 255, 255, 0.2) !important;
    }

    .glass-panel, .admin-panel-section, .admin-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.055) 0%, rgba(15, 17, 28, 0.8) 100%) !important;
      backdrop-filter: blur(20px) saturate(180%) !important;
      -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
      border: 1px solid rgba(255, 255, 255, 0.14) !important;
      border-radius: 1.15rem;
      box-shadow: 0 12px 36px 0 rgba(0, 0, 0, 0.48), inset 0 1px 0 0 rgba(255, 255, 255, 0.15);
    }

    .player-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(16, 18, 30, 0.75) 100%) !important;
      backdrop-filter: blur(20px) saturate(180%) !important;
      -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
      border: 1px solid rgba(255, 255, 255, 0.13) !important;
      border-radius: 1.1rem;
      box-shadow: 0 10px 32px 0 rgba(0, 0, 0, 0.42), inset 0 1px 0 0 rgba(255, 255, 255, 0.14);
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .player-card:hover {
      transform: translateY(-2px);
      border-color: rgba(255, 78, 0, 0.5) !important;
      box-shadow: 0 18px 38px rgba(0, 0, 0, 0.5), 0 0 22px rgba(255, 78, 0, 0.18), inset 0 1px 0 0 rgba(255, 255, 255, 0.22);
    }

    /* Buttons */
    .btn-fire {
      background: #ff4e00 !important;
      color: #ffffff !important;
      font-weight: 700;
      letter-spacing: 0.03em;
      border: 1px solid rgba(255, 255, 255, 0.18) !important;
      padding: 9px 20px;
      border-radius: 10px;
      box-shadow: 0 4px 18px rgba(255, 78, 0, 0.35);
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-fire:hover {
      background: #ff5f1a !important;
      box-shadow: 0 6px 24px rgba(255, 78, 0, 0.55);
      transform: translateY(-1px);
    }

    .btn-glass {
      background: rgba(255, 255, 255, 0.05) !important;
      border: 1px solid var(--glass-border) !important;
      color: #e5e7eb !important;
      padding: 8px 16px;
      border-radius: 10px;
      backdrop-filter: blur(10px) !important;
      -webkit-backdrop-filter: blur(10px) !important;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      font-weight: 600;
      transition: all 0.2s ease;
    }

    .btn-glass:hover {
      background: rgba(255, 255, 255, 0.1) !important;
      border-color: rgba(255, 255, 255, 0.25) !important;
      color: #ffffff !important;
    }

    .btn-glass-active {
      background: #ff4e00 !important;
      border-color: #ff4e00 !important;
      color: #ffffff !important;
      box-shadow: 0 2px 14px rgba(255, 78, 0, 0.4) !important;
    }

    /* Badges */
    .badge-official {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(16, 185, 129, 0.12);
      border: 1px solid rgba(16, 185, 129, 0.35);
      color: #10b981;
      font-family: var(--ff-font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      padding: 3px 10px;
      border-radius: 9999px;
      text-transform: uppercase;
    }

    .badge-unofficial {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      background: rgba(245, 158, 11, 0.12);
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: #f59e0b;
      font-family: var(--ff-font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      padding: 3px 10px;
      border-radius: 9999px;
      text-transform: uppercase;
    }

    .badge-live {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(255, 78, 0, 0.15);
      border: 1px solid rgba(255, 78, 0, 0.4);
      color: #ff4e00;
      font-family: var(--ff-font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
      text-transform: uppercase;
    }

    .live-dot {
      width: 7px;
      height: 7px;
      background: #ff4e00;
      border-radius: 50%;
      box-shadow: 0 0 8px #ff4e00;
      animation: live-ping 1.5s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @keyframes live-ping {
      0% { transform: scale(0.9); opacity: 1; }
      50% { transform: scale(1.4); opacity: 0.6; }
      100% { transform: scale(0.9); opacity: 1; }
    }

    /* Stat Box */
    .stat-box {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(12, 14, 24, 0.75) 100%) !important;
      backdrop-filter: blur(14px) !important;
      -webkit-backdrop-filter: blur(14px) !important;
      border: 1px solid rgba(255, 255, 255, 0.11) !important;
      border-radius: 0.85rem;
      padding: 10px 12px;
      text-align: center;
      box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.08), 0 4px 16px rgba(0, 0, 0, 0.3);
      transition: all 0.2s ease;
    }

    .stat-box-value {
      font-family: var(--ff-font-display);
      font-size: 1.75rem;
      line-height: 1.1;
      font-weight: 700;
      color: #fff;
    }

    .stat-box-label {
      font-size: 0.7rem;
      color: #9ca3af;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-weight: 600;
    }

    /* Glass Inputs */
    input[type="text"], input[type="password"], input[type="number"], input[type="date"], select, textarea, .glass-input {
      background-color: rgba(12, 14, 24, 0.85) !important;
      backdrop-filter: blur(12px) !important;
      -webkit-backdrop-filter: blur(12px) !important;
      border: 1px solid rgba(255, 255, 255, 0.16) !important;
      box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.4);
      color: #ffffff !important;
    }

    input[type="text"]:focus, input[type="password"]:focus, input[type="number"]:focus, input[type="date"]:focus, select:focus, textarea:focus, .glass-input:focus {
      border-color: rgba(255, 78, 0, 0.75) !important;
      box-shadow: 0 0 15px rgba(255, 78, 0, 0.3), inset 0 1px 2px rgba(0, 0, 0, 0.3) !important;
      outline: none;
    }

    /* Modal */
    .glass-modal {
      background: linear-gradient(135deg, rgba(25, 28, 44, 0.96) 0%, rgba(10, 12, 20, 0.98) 100%) !important;
      backdrop-filter: blur(24px) saturate(190%) !important;
      -webkit-backdrop-filter: blur(24px) saturate(190%) !important;
      border: 1px solid rgba(255, 255, 255, 0.18) !important;
      border-radius: 1.25rem;
      box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.8), 0 0 35px rgba(255, 78, 0, 0.18), inset 0 1px 0 0 rgba(255, 255, 255, 0.22);
    }
  </style>
</head>
<body class="bg-[#050508] text-gray-100 min-h-screen flex flex-col antialiased selection:bg-[#ff4e00] selection:text-white">
  <!-- Sophisticated Dark Ambient Glow -->
  <div class="site-ambient-glow"></div>
  <div class="site-ambient-glow-bottom"></div>

  <!-- Dynamic Site Background Layer with Blur -->
  <div id="site-global-bg-layer" class="site-bg-layer" style="background-image: url('<%- (typeof settings !== 'undefined' && settings.site_background_url) ? settings.site_background_url : 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop' %>');"></div>
  <div class="site-bg-overlay"></div>

  <script>
    (function() {
      // Admin session & token synchronization for iframe preview resilience
      const serverTk = "<%= (typeof activeAdminToken !== 'undefined' && activeAdminToken) ? activeAdminToken : '' %>";
      const urlParams = new URLSearchParams(window.location.search);
      const urlTk = urlParams.get('tk') || urlParams.get('auth_token');
      
      let tk = serverTk || urlTk;
      if (!tk) {
        try {
          tk = localStorage.getItem('tag_admin_token') || sessionStorage.getItem('tag_admin_token') || '';
        } catch (e) {}
      }

      if (tk) {
        try {
          localStorage.setItem('tag_admin_token', tk);
          sessionStorage.setItem('tag_admin_token', tk);
        } catch (e) {}

        // If on an /admin page (except login/logout) and no tk in URL, append tk to preserve admin access in iframes
        if (window.location.pathname.startsWith('/admin') && !window.location.pathname.startsWith('/admin/login') && !window.location.pathname.startsWith('/admin/logout') && !window.location.search.includes('tk=')) {
          const sep = window.location.search ? '&' : '?';
          window.location.replace(window.location.pathname + window.location.search + sep + 'tk=' + encodeURIComponent(tk));
          return;
        }

        function syncAdminElements() {
          // Automatically attach token to internal admin forms
          document.querySelectorAll('form[action^="/admin"]').forEach(form => {
            const action = form.getAttribute('action') || '';
            if (!action.includes('tk=') && !action.startsWith('/admin/login') && !action.startsWith('/admin/logout')) {
              const sep = action.includes('?') ? '&' : '?';
              form.setAttribute('action', action + sep + 'tk=' + encodeURIComponent(tk));
            }
            if (!form.querySelector('input[name="admin_token"]') && !action.startsWith('/admin/login') && !action.startsWith('/admin/logout')) {
              const hidden = document.createElement('input');
              hidden.type = 'hidden';
              hidden.name = 'admin_token';
              hidden.value = tk;
              form.appendChild(hidden);
            }
          });

          // Automatically attach token to internal admin links
          document.querySelectorAll('a[href^="/admin"]').forEach(link => {
            const href = link.getAttribute('href');
            if (href && !href.includes('tk=') && !href.startsWith('/admin/login') && !href.startsWith('/admin/logout')) {
              const sep = href.includes('?') ? '&' : '?';
              link.setAttribute('href', href + sep + 'tk=' + encodeURIComponent(tk));
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncAdminElements);
        } else {
          syncAdminElements();
        }

        // Global click interceptor for admin navigation resilience
        document.addEventListener('click', (e) => {
          const link = e.target.closest('a[href^="/admin"]');
          if (link) {
            const href = link.getAttribute('href');
            if (href && !href.includes('tk=') && !href.startsWith('/admin/login') && !href.startsWith('/admin/logout')) {
              const sep = href.includes('?') ? '&' : '?';
              link.setAttribute('href', href + sep + 'tk=' + encodeURIComponent(tk));
            }
          }
        }, true);

        // Global form submit interceptor for admin token resilience
        document.addEventListener('submit', (e) => {
          const form = e.target.closest('form');
          if (form) {
            const action = form.getAttribute('action') || '';
            if (action.startsWith('/admin') && !action.includes('tk=') && !action.startsWith('/admin/login') && !action.startsWith('/admin/logout')) {
              const sep = action.includes('?') ? '&' : '?';
              form.setAttribute('action', action + sep + 'tk=' + encodeURIComponent(tk));
            }
            if (!form.querySelector('input[name="admin_token"]') && !action.startsWith('/admin/login') && !action.startsWith('/admin/logout')) {
              const hidden = document.createElement('input');
              hidden.type = 'hidden';
              hidden.name = 'admin_token';
              hidden.value = tk;
              form.appendChild(hidden);
            }
          }
        }, true);
      }
    })();
  </script>

