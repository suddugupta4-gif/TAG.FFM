  </footer>

  <% if (isAdmin) { %>
    <!-- Background Photo Customizer Modal (Admin Only) -->
    <%- include('background_modal') %>
  <% } %>

  <!-- Scripts -->
  <script>
    // Client-side Unique Visitor Handshake (Ensures 1 increment per device, 0 increments on refresh)
    (function() {
      try {
        var KEY = 'tag_unique_visitor_v1';
        var visitorId = localStorage.getItem(KEY);
        if (!visitorId) {
          visitorId = 'v_' + Math.random().toString(36).substring(2, 11) + '_' + Date.now().toString(36);
          localStorage.setItem(KEY, visitorId);
          fetch('/api/visitors/record', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ visitorId: visitorId })
          })
          .then(function(r) { return r.json(); })
          .then(function(data) {
            if (data && data.formattedVisitors) {
              var counter = document.getElementById('footer-visitors-counter');
              if (counter) counter.textContent = data.formattedVisitors;
            }
          })
          .catch(function() {});
        }
      } catch (e) {}
    })();
  </script>
  <script src="/js/main.js"></script>
</body>
</html>
