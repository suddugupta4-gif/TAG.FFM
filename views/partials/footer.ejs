          </div>

          <!-- Live Status Indicator -->
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-emerald-950/40 border border-emerald-500/30 text-[10px] font-mono text-emerald-400">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>LIVE TELEMETRY</span>
          </div>
        </div>

        <!-- Right: Developer Credit / Instagram Badge -->
        <div class="flex items-center justify-center md:justify-end">
          <a 
            href="https://www.instagram.com/sujal_editxss?igsh=aTkyMmxmMDc5bG5p" 
            target="_blank" 
            rel="noopener noreferrer" 
            class="inline-flex items-center justify-center gap-2 px-4 py-1.5 rounded-full font-mono text-xs font-bold bg-gradient-to-r from-orange-500/20 via-amber-500/20 to-orange-500/20 text-[#ff4e00] hover:text-white border border-[#ff4e00]/40 hover:border-[#ff4e00] shadow-lg shadow-orange-950/30 hover:scale-105 hover:shadow-orange-500/20 transition-all duration-200 group"
            title="Follow Developer on Instagram (@sujal_editxss)"
          >
            <span class="w-2 h-2 rounded-full bg-[#ff4e00] group-hover:bg-orange-400 animate-pulse"></span>
            <span class="tracking-wider">DEVELOPED BY SUJALSEXY</span>
            <svg class="w-3.5 h-3.5 text-[#ff4e00] group-hover:text-white group-hover:translate-x-0.5 transition-all" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
