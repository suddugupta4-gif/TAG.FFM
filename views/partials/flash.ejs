<% if (typeof success !== 'undefined' && success) { %>
  <div class="mb-6 p-4 rounded-xl bg-emerald-950/60 border border-emerald-500/40 text-emerald-300 flex items-center justify-between shadow-lg shadow-emerald-900/20 backdrop-blur-md">
    <div class="flex items-center gap-3">
      <svg class="w-5 h-5 text-emerald-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span class="text-sm font-medium"><%= success %></span>
    </div>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="mb-6 p-4 rounded-xl bg-red-950/60 border border-red-500/40 text-red-300 flex items-center justify-between shadow-lg shadow-red-900/20 backdrop-blur-md">
    <div class="flex items-center gap-3">
      <svg class="w-5 h-5 text-red-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span class="text-sm font-medium"><%= error %></span>
    </div>
  </div>
<% } %>
