<!-- Background Photo Customizer Modal (Admin Only) -->
<div id="backgroundModal" class="fixed inset-0 bg-black/80 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
  <div class="glass-modal max-w-xl w-full p-6 sm:p-7 space-y-6 relative animate-smooth-in">
    
    <!-- Close Button -->
    <button 
      type="button" 
      onclick="closeBackgroundModal()" 
      class="absolute top-4 right-4 text-slate-400 hover:text-white text-2xl font-bold w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/10 transition-colors"
      aria-label="Close modal"
    >
      &times;
    </button>

    <!-- Modal Header -->
    <div class="border-b border-white/10 pb-3">
      <div class="flex items-center gap-2">
        <span class="badge-official text-[10px] py-0.5">ADMIN THEME CONTROL</span>
        <span class="text-xs font-mono text-orange-400">GLOBAL WEBSITE WALLPAPER</span>
      </div>
      <h3 class="font-display text-3xl font-bold text-white tracking-wide mt-1 flex items-center gap-2">
        <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        Admin Background Customizer
      </h3>
      <p class="text-xs text-slate-300 mt-1">Upload a background photo file or enter an image URL. It saves to the database for all visitors.</p>
    </div>

    <!-- Live Preview Box -->
    <div class="space-y-2">
      <div class="flex items-center justify-between text-xs font-mono">
        <span class="text-slate-300 uppercase">Live Wallpaper Preview</span>
        <span id="bgStatusBadge" class="text-emerald-400">Active</span>
      </div>
      <div class="relative h-36 rounded-xl overflow-hidden border border-white/20 bg-slate-950 shadow-inner group">
        <img id="bgModalLivePreview" src="<%- (typeof settings !== 'undefined' && settings.site_background_url) ? settings.site_background_url : 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop' %>" alt="Wallpaper Preview" class="w-full h-full object-cover">
        
        <!-- Demonstration Glass Box over preview -->
        <div class="absolute inset-0 bg-black/30 backdrop-blur-xs flex items-center justify-center p-4">
          <div class="glass p-3 rounded-lg border border-white/20 text-center shadow-lg">
            <span class="text-xs font-mono font-bold text-orange-400">FROSTED GLASS UI TEST</span>
            <p class="text-[11px] text-white/90">All cards, panels & tables adapt over your background</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Admin Server-Side Persistence Form -->
    <form action="/admin/settings/background" method="POST" enctype="multipart/form-data" class="space-y-4" id="adminBgForm">
      
      <!-- 1. File Upload with Sharp Compression -->
      <div class="p-3.5 rounded-xl bg-slate-900/80 border border-orange-500/25 space-y-2">
        <label class="block text-xs font-mono text-orange-400 uppercase font-bold">1. Upload Photo File (Sharp WebP Auto-Compression)</label>
        <div class="flex items-center gap-3">
          <label class="btn-fire cursor-pointer text-xs py-2.5 px-4 flex-1 justify-center flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span id="bgModalFileName">Choose Background File</span>
            <input type="file" name="background" id="bgModalFileInput" accept="image/*" class="hidden" onchange="handleBgFileSelect(this)">
          </label>
          <button type="submit" class="btn-glass text-xs py-2.5 px-4 border-orange-500/40 text-white hover:bg-orange-500/20">
            Save File
          </button>
        </div>
        <p class="text-[11px] font-mono text-slate-400">Any resolution up to 4K. Compressed to WebP.</p>
      </div>

      <!-- 2. Direct URL -->
      <div class="space-y-1.5">
        <label for="bg_url_input" class="block text-xs font-mono text-slate-300 uppercase">2. Or Paste Direct Image URL</label>
        <div class="flex gap-2">
          <input 
            type="text" 
            id="bg_url_input" 
            name="background_url" 
            value="<%- (typeof settings !== 'undefined' && settings.site_background_url) ? settings.site_background_url : '' %>"
            placeholder="https://images.unsplash.com/..." 
            class="flex-1 px-3.5 py-2 rounded-xl bg-slate-900/90 border border-white/15 text-white text-xs font-mono focus:outline-none focus:border-orange-500"
            oninput="handleBgUrlChange(this.value)"
          >
          <button type="submit" class="btn-glass text-xs py-2 px-4 whitespace-nowrap">
            Save URL
          </button>
        </div>
      </div>

      <!-- 3. Curated Esports Presets -->
      <div class="space-y-2 pt-2 border-t border-white/10">
        <label class="block text-xs font-mono text-slate-300 uppercase">3. Or Pick Curated Esports Theme</label>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
          <button 
            type="button" 
            onclick="selectPresetBg('https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop', 'Cyber Arena')"
            class="p-2 rounded-lg bg-slate-900 border border-white/10 hover:border-orange-500 text-left transition-all group"
          >
            <div class="h-12 rounded bg-cover bg-center mb-1" style="background-image: url('https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=300&auto=format&fit=crop');"></div>
            <span class="text-[11px] font-mono text-slate-300 group-hover:text-orange-400 block truncate font-bold">Cyber Arena</span>
          </button>

          <button 
            type="button" 
            onclick="selectPresetBg('https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=2070&auto=format&fit=crop', 'Neon Stadium')"
            class="p-2 rounded-lg bg-slate-900 border border-white/10 hover:border-orange-500 text-left transition-all group"
          >
            <div class="h-12 rounded bg-cover bg-center mb-1" style="background-image: url('https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=300&auto=format&fit=crop');"></div>
            <span class="text-[11px] font-mono text-slate-300 group-hover:text-orange-400 block truncate font-bold">Neon Stadium</span>
          </button>

          <button 
            type="button" 
            onclick="selectPresetBg('https://images.unsplash.com/photo-1538481199705-c710c4e965fc?q=80&w=2070&auto=format&fit=crop', 'Kalahari Battle')"
            class="p-2 rounded-lg bg-slate-900 border border-white/10 hover:border-orange-500 text-left transition-all group"
          >
            <div class="h-12 rounded bg-cover bg-center mb-1" style="background-image: url('https://images.unsplash.com/photo-1538481199705-c710c4e965fc?q=80&w=300&auto=format&fit=crop');"></div>
            <span class="text-[11px] font-mono text-slate-300 group-hover:text-orange-400 block truncate font-bold">Kalahari Battle</span>
          </button>

          <button 
            type="button" 
            onclick="selectPresetBg('https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=2070&auto=format&fit=crop', 'Dark Ember')"
            class="p-2 rounded-lg bg-slate-900 border border-white/10 hover:border-orange-500 text-left transition-all group"
          >
            <div class="h-12 rounded bg-cover bg-center mb-1" style="background-image: url('https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=300&auto=format&fit=crop');"></div>
            <span class="text-[11px] font-mono text-slate-300 group-hover:text-orange-400 block truncate font-bold">Dark Ember</span>
          </button>
        </div>
      </div>

      <!-- Footer Controls -->
      <div class="flex items-center justify-between pt-2 border-t border-white/10 text-xs">
        <a href="/admin/settings" class="text-orange-400 hover:underline font-mono">
          Full Settings Page &rarr;
        </a>
        <button type="submit" class="btn-fire py-2 px-5">
          Save Changes
        </button>
      </div>

    </form>

  </div>
</div>

<script>
  function openBackgroundModal() {
    const modal = document.getElementById('backgroundModal');
    if (modal) {
      modal.classList.remove('hidden');
    }
  }

  function closeBackgroundModal() {
    const modal = document.getElementById('backgroundModal');
    if (modal) modal.classList.add('hidden');
  }

  function handleBgFileSelect(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const reader = new FileReader();
      reader.onload = function(e) {
        const previewImg = document.getElementById('bgModalLivePreview');
        if (previewImg) previewImg.src = e.target.result;
        
        const bgLayer = document.querySelector('.site-bg-layer');
        if (bgLayer) bgLayer.style.backgroundImage = `url("${e.target.result}")`;
      };
      reader.readAsDataURL(file);

      const label = document.getElementById('bgModalFileName');
      if (label) label.textContent = file.name.length > 20 ? file.name.substring(0, 17) + '...' : file.name;
    }
  }

  function handleBgUrlChange(url) {
    if (url && url.trim().startsWith('http')) {
      const previewImg = document.getElementById('bgModalLivePreview');
      if (previewImg) previewImg.src = url.trim();
      const bgLayer = document.querySelector('.site-bg-layer');
      if (bgLayer) bgLayer.style.backgroundImage = `url("${url.trim()}")`;
    }
  }

  function selectPresetBg(url, name) {
    const previewImg = document.getElementById('bgModalLivePreview');
    if (previewImg) previewImg.src = url;
    
    const bgLayer = document.querySelector('.site-bg-layer');
    if (bgLayer) bgLayer.style.backgroundImage = `url("${url}")`;

    const adminUrlInput = document.getElementById('bg_url_input');
    if (adminUrlInput) adminUrlInput.value = url;
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeBackgroundModal();
  });

  document.getElementById('backgroundModal')?.addEventListener('click', function(e) {
    if (e.target === this) closeBackgroundModal();
  });
</script>
