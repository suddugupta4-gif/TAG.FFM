<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <%- include('../partials/flash') %>

  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <a href="/admin" class="text-xs font-mono text-slate-400 hover:text-orange-400">&larr; Admin Dashboard</a>
      </div>
      <h1 class="font-display text-4xl font-bold text-white tracking-wide">Tournament Management</h1>
    </div>

    <a href="/admin/tournaments/new" class="btn-fire text-xs py-2 px-4 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Create New Tournament
    </a>
  </div>

  <!-- Tournaments Table -->
  <div class="glass-panel p-6 overflow-x-auto">
    <table class="glass-table">
      <thead>
        <tr>
          <th>Tournament</th>
          <th class="text-center">Mode</th>
          <th class="text-center">Prize Pool</th>
          <th class="text-center">Status</th>
          <th class="text-center">Featured (Home)</th>
          <th class="text-right">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% tournaments.forEach(t => { %>
          <tr class="table-row">
            <td>
              <div class="flex items-center gap-3">
                <img src="<%= t.banner_url %>" alt="" class="w-14 h-10 rounded-lg object-cover bg-slate-800 border border-white/10" onerror="this.src='https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=800&auto=format&fit=crop'">
                <div>
                  <a href="/tournament/<%= t.id %>" class="font-bold text-white hover:text-orange-400 text-base block">
                    <%= t.name %>
                  </a>
                  <span class="text-xs text-slate-400 font-mono">ID: #<%= t.id %></span>
                </div>
              </div>
            </td>
            <td class="text-center text-xs font-mono text-slate-300"><%= t.game_mode %></td>
            <td class="text-center text-xs font-mono text-amber-400 font-bold"><%= t.prize_pool %></td>
            <td class="text-center">
              <span class="px-2 py-0.5 rounded text-[11px] font-mono <%= t.status === 'ongoing' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-white/10 text-slate-300' %>">
                <%= t.status %>
              </span>
            </td>
            <td class="text-center">
              <% if (t.is_current) { %>
                <span class="badge-live"><span class="live-dot"></span> CURRENT</span>
              <% } else { %>
                <form action="/admin/tournaments/<%= t.id %>/set-current" method="POST" class="inline">
                  <button type="submit" class="btn-glass text-[11px] py-1 px-2.5 hover:text-orange-400">
                    Set as Current
                  </button>
                </form>
              <% } %>
            </td>
            <td class="text-right">
              <div class="inline-flex items-center gap-2">
                <a href="/admin/matches?tournament_id=<%= t.id %>" class="btn-glass text-xs py-1 px-2.5 text-emerald-400" title="Manage Matches">
                  Matches
                </a>
                <a href="/admin/tournaments/<%= t.id %>/edit" class="btn-glass text-xs py-1 px-2.5 text-slate-200" title="Edit">
                  Edit
                </a>
                <form action="/admin/tournaments/<%= t.id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this tournament? All match results will be removed.');" class="inline">
                  <button type="submit" class="btn-glass text-xs py-1 px-2 text-red-400 hover:bg-red-500/20" title="Delete">
                    &times;
                  </button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

</main>

<%- include('../partials/footer') %>
