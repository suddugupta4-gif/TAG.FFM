<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <%- include('../partials/flash') %>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <a href="/admin" class="text-xs font-mono text-slate-400 hover:text-orange-400">&larr; Admin Dashboard</a>
      </div>
      <h1 class="font-display text-4xl font-bold text-white tracking-wide">Match Results & Official Verification</h1>
      <p class="text-slate-400 text-sm">Lock in confirmed scoreboard results or keep provisional live match scores.</p>
    </div>

    <a href="/admin/matches/new?tournament_id=<%= selectedTourneyId %>" class="btn-fire text-xs py-2 px-4 flex items-center gap-2">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Log New Match Result
    </a>
  </div>

  <!-- Tournament Filter Selector & Batch Creator Toggle -->
  <div class="glass-panel p-4 flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <span class="text-xs font-mono text-slate-300 uppercase">Selected Tournament:</span>
      <select onchange="window.location.href='/admin/matches?tournament_id='+this.value" class="px-3 py-1.5 rounded-lg bg-slate-900 border border-white/20 text-white text-xs font-mono focus:outline-none focus:border-orange-500">
        <% tournaments.forEach(t => { %>
          <option value="<%= t.id %>" <%= t.id === selectedTourneyId ? 'selected' : '' %>>
            <%= t.name %> <%= t.is_current ? '(CURRENT)' : '' %>
          </option>
        <% }); %>
      </select>
    </div>

    <div class="flex items-center gap-3 text-xs font-mono">
      <span class="badge-official">Official: <%= matches.filter(m => m.is_official).length %></span>
      <span class="badge-unofficial">Unofficial: <%= matches.filter(m => !m.is_official).length %></span>
      <a href="/history" class="btn-glass text-xs py-1.5 px-3 text-orange-400 flex items-center gap-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        View Public History
      </a>
    </div>
  </div>

  <!-- Quick Match Selection (1-6) & All Maps Batch Adder -->
  <div class="glass-panel p-6 border border-orange-500/30 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/10 pb-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="badge-official text-[10px]">BATCH GENERATOR</span>
          <span class="text-xs font-mono text-orange-400">Add Matches (1–6) With Map Selection</span>
        </div>
        <h3 class="font-display text-xl font-bold text-white tracking-wide mt-1">
          Quick Match Selection (1–6) & Map Archiving
        </h3>
      </div>
      <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/20">
        Automatically Saves to History Ledger
      </span>
    </div>

    <form action="/admin/matches/batch" method="POST" class="space-y-4">
      <input type="hidden" name="tournament_id" value="<%= selectedTourneyId %>">

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Match Count 1 to 6 -->
        <div>
          <label class="block text-xs font-mono text-slate-300 uppercase mb-1">Number of Matches (1–6) *</label>
          <select name="match_count" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-white/20 text-white text-xs font-mono focus:border-orange-500 focus:outline-none" onchange="toggleBatchMapSlots(this.value)">
            <option value="1">1 Match</option>
            <option value="2">2 Matches</option>
            <option value="3">3 Matches</option>
            <option value="4">4 Matches</option>
            <option value="5">5 Matches</option>
            <option value="6" selected>6 Matches (Standard Day)</option>
          </select>
        </div>

        <!-- Official Status -->
        <div>
          <label class="block text-xs font-mono text-slate-300 uppercase mb-1">Verification Status</label>
          <select name="is_official" class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-white/20 text-white text-xs font-mono focus:border-orange-500 focus:outline-none">
            <option value="true" selected>Official Esports Tournament</option>
            <option value="false">Unofficial / Local Community</option>
          </select>
        </div>
      </div>

      <!-- Map Selection for Matches 1-6 -->
      <div class="space-y-2">
        <label class="block text-xs font-mono text-slate-400 uppercase">Map Selection for Each Match:</label>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2" id="batch-map-slots">
          
          <div class="p-2.5 rounded-lg bg-black/40 border border-white/10 space-y-1" id="b-slot-1">
            <span class="text-[10px] font-mono text-orange-400 font-bold block">Match #1 Map</span>
            <select name="match_1_map" class="w-full px-2 py-1 rounded bg-slate-900 border border-white/10 text-white text-xs font-mono">
              <option value="Bermuda" selected>Bermuda</option>
              <option value="Purgatory">Purgatory</option>
              <option value="Kalahari">Kalahari</option>
              <option value="Alpine">Alpine</option>
              <option value="Nexterra">Nexterra</option>
            </select>
          </div>

          <div class="p-2.5 rounded-lg bg-black/40 border border-white/10 space-y-1" id="b-slot-2">
            <span class="text-[10px] font-mono text-orange-400 font-bold block">Match #2 Map</span>
            <select name="match_2_map" class="w-full px-2 py-1 rounded bg-slate-900 border border-white/10 text-white text-xs font-mono">
              <option value="Bermuda">Bermuda</option>
              <option value="Purgatory" selected>Purgatory</option>
              <option value="Kalahari">Kalahari</option>
              <option value="Alpine">Alpine</option>
              <option value="Nexterra">Nexterra</option>
            </select>
          </div>

          <div class="p-2.5 rounded-lg bg-black/40 border border-white/10 space-y-1" id="b-slot-3">
            <span class="text-[10px] font-mono text-orange-400 font-bold block">Match #3 Map</span>
            <select name="match_3_map" class="w-full px-2 py-1 rounded bg-slate-900 border border-white/10 text-white text-xs font-mono">
              <option value="Bermuda">Bermuda</option>
              <option value="Purgatory">Purgatory</option>
              <option value="Kalahari" selected>Kalahari</option>
              <option value="Alpine">Alpine</option>
              <option value="Nexterra">Nexterra</option>
            </select>
          </div>

          <div class="p-2.5 rounded-lg bg-black/40 border border-white/10 space-y-1" id="b-slot-4">
            <span class="text-[10px] font-mono text-orange-400 font-bold block">Match #4 Map</span>
            <select name="match_4_map" class="w-full px-2 py-1 rounded bg-slate-900 border border-white/10 text-white text-xs font-mono">
              <option value="Bermuda">Bermuda</option>
              <option value="Purgatory">Purgatory</option>
              <option value="Kalahari">Kalahari</option>
              <option value="Alpine" selected>Alpine</option>
              <option value="Nexterra">Nexterra</option>
            </select>
          </div>

          <div class="p-2.5 rounded-lg bg-black/40 border border-white/10 space-y-1" id="b-slot-5">
            <span class="text-[10px] font-mono text-orange-400 font-bold block">Match #5 Map</span>
            <select name="match_5_map" class="w-full px-2 py-1 rounded bg-slate-900 border border-white/10 text-white text-xs font-mono">
              <option value="Bermuda">Bermuda</option>
              <option value="Purgatory">Purgatory</option>
              <option value="Kalahari">Kalahari</option>
              <option value="Alpine">Alpine</option>
              <option value="Nexterra" selected>Nexterra</option>
            </select>
          </div>

          <div class="p-2.5 rounded-lg bg-black/40 border border-orange-500/30 space-y-1" id="b-slot-6">
            <span class="text-[10px] font-mono text-orange-400 font-bold block">Match #6 Map (Random Decider)</span>
            <select name="match_6_map" class="w-full px-2 py-1 rounded bg-slate-900 border border-orange-500/40 text-white text-xs font-mono">
              <option value="Random" selected>🎲 Random Selection (5 Maps)</option>
              <option value="Bermuda">Bermuda</option>
              <option value="Purgatory">Purgatory</option>
              <option value="Kalahari">Kalahari</option>
              <option value="Alpine">Alpine</option>
              <option value="Nexterra">Nexterra</option>
            </select>
          </div>

        </div>
      </div>

      <div class="flex items-center justify-end pt-2">
        <button type="submit" class="btn-fire text-xs py-2.5 px-5 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Batch Create 1–6 Matches & Auto-Save to History
        </button>
      </div>
    </form>
  </div>

  <script>
    function toggleBatchMapSlots(count) {
      const c = parseInt(count, 10);
      for (let i = 1; i <= 6; i++) {
        const slot = document.getElementById('b-slot-' + i);
        if (slot) {
          if (i <= c) slot.classList.remove('hidden');
          else slot.classList.add('hidden');
        }
      }
    }
  </script>

  <!-- Match List with Instant Official Toggle Buttons -->
  <div class="space-y-4">
    <% if (matches.length === 0) { %>
      <div class="glass-card p-12 text-center text-slate-400">
        <p>No matches recorded for this tournament yet.</p>
        <a href="/admin/matches/new?tournament_id=<%= selectedTourneyId %>" class="btn-fire text-xs mt-4 inline-flex">
          Log First Match
        </a>
      </div>
    <% } else { %>
      <% matches.forEach(match => { %>
        <div class="glass-card p-6 border-l-4 <%= match.is_official ? 'border-l-emerald-500' : 'border-l-amber-500' %>">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/10 pb-4 mb-4">
            <div class="flex items-center gap-3">
              <span class="font-display text-3xl font-bold text-white">MATCH #<%= match.match_number %></span>
              <span class="px-2.5 py-0.5 rounded-md bg-white/10 font-mono text-xs text-slate-300">
                Map: <%= match.map_name %>
              </span>
              <span class="text-xs font-mono text-slate-500">
                <%= new Date(match.played_at).toLocaleDateString() %>
              </span>
            </div>

            <!-- OFFICIAL / UNOFFICIAL STATUS TOGGLE -->
            <div class="flex items-center gap-3">
              <span id="match-badge-<%= match.id %>" class="<%= match.is_official ? 'badge-official' : 'badge-unofficial' %>">
                <% if (match.is_official) { %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                  OFFICIAL
                <% } else { %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  UNOFFICIAL
                <% } %>
              </span>

              <!-- Live AJAX Toggle Button -->
              <button 
                type="button" 
                class="admin-toggle-official-btn btn-glass text-xs <%= match.is_official ? 'text-amber-400 hover:text-amber-300' : 'text-emerald-400 hover:text-emerald-300' %>"
                data-match-id="<%= match.id %>"
                data-is-official="<%= match.is_official %>"
              >
                <% if (match.is_official) { %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                  Set Unofficial
                <% } else { %>
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  Confirm Official
                <% } %>
              </button>

              <form action="<%= adminHref('/admin/matches/' + match.id + '/delete') %>" method="POST" onsubmit="return confirm('Delete this match and all team scores?');" class="inline">
                <% if (typeof activeAdminToken !== 'undefined' && activeAdminToken) { %>
                  <input type="hidden" name="admin_token" value="<%= activeAdminToken %>">
                <% } %>
                <button type="submit" class="btn-glass text-xs py-1.5 px-2 text-red-400 hover:bg-red-500/20" title="Delete Match">
                  &times;
                </button>
              </form>
            </div>
          </div>

          <% if (match.notes) { %>
            <p class="text-xs text-slate-400 italic mb-4"><%= match.notes %></p>
          <% } %>

          <!-- Scoreboard Table for Match -->
          <% if (match.results && match.results.length > 0) { %>
            <div class="overflow-x-auto">
              <table class="w-full text-xs font-mono text-left">
                <thead class="text-slate-400 border-b border-white/5">
                  <tr>
                    <th class="py-1.5 px-2">Place</th>
                    <th class="py-1.5 px-2">Team</th>
                    <th class="py-1.5 px-2 text-center">Kills</th>
                    <th class="py-1.5 px-2 text-center">Placement Pts</th>
                    <th class="py-1.5 px-2 text-center">Kill Pts</th>
                    <th class="py-1.5 px-2 text-right">Total Score</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5">
                  <% match.results.forEach(r => { %>
                    <tr class="<%= r.placement === 1 ? 'text-amber-400 font-bold bg-amber-500/10' : 'text-slate-300' %>">
                      <td class="py-2 px-2">#<%= r.placement %></td>
                      <td class="py-2 px-2 flex items-center gap-2 font-sans font-semibold">
                        <img src="<%= r.team_logo %>" alt="" class="w-4 h-4 rounded object-cover" onerror="this.style.display='none'">
                        <%= r.team_name %> [<%= r.team_tag %>]
                      </td>
                      <td class="py-2 px-2 text-center"><%= r.kills %></td>
                      <td class="py-2 px-2 text-center text-slate-400"><%= r.placement_points %></td>
                      <td class="py-2 px-2 text-center text-slate-400"><%= r.kill_points %></td>
                      <td class="py-2 px-2 text-right font-bold text-white"><%= r.total_points %> PTS</td>
                    </tr>
                  <% }); %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      <% }); %>
    <% } %>
  </div>

</main>

<%- include('../partials/footer') %>
