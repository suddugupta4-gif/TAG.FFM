<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="flex-1 max-w-md w-full mx-auto px-4 py-12 sm:py-16 flex flex-col justify-center">
  <div class="glass-panel p-6 sm:p-8 space-y-6 border-orange-500/30 shadow-2xl shadow-orange-950/30">
    <div class="text-center space-y-2">
      <div class="w-14 h-14 rounded-2xl bg-orange-500/20 border border-orange-500/30 text-orange-400 mx-auto flex items-center justify-center shadow-lg shadow-orange-500/20">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
      </div>
      <h1 class="font-display text-3xl font-bold text-white tracking-wide">Admin Access</h1>
      <p class="text-xs text-slate-400">Authenticate to manage tournaments, scores & rosters.</p>
    </div>

    <!-- Error Alert Box -->
    <div id="login-error-box" class="hidden p-3 rounded-xl bg-red-500/10 border border-red-500/30 text-red-300 text-xs font-mono flex items-center gap-2">
      <svg class="w-4 h-4 shrink-0 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span id="login-error-text"><%= typeof error !== 'undefined' && error ? error : '' %></span>
    </div>

    <form id="admin-login-form" action="/admin/login" method="POST" class="space-y-4" autocomplete="off">
      <input type="hidden" id="redirect-input" name="redirect" value="<%= redirect %>">
      
      <div class="space-y-1.5">
        <div class="flex items-center justify-between">
          <label for="password" class="block text-xs font-mono text-slate-300 uppercase">Admin Access Key</label>
          <span class="text-[10px] font-mono text-emerald-400 font-bold">✓ Direct Access Ready</span>
        </div>

        <div class="relative">
          <input 
            type="password" 
            id="password" 
            name="password" 
            autocomplete="new-password"
            placeholder="Password (Optional - Click Enter Below)"
            value="Taggontoppp379@"
            class="w-full pl-4 pr-11 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm font-mono tracking-wider"
          >
          <button 
            type="button" 
            id="toggle-pwd-btn"
            class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white p-1 rounded transition-colors touch-manipulation"
            title="Show/Hide Password"
          >
            <svg id="eye-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
            </svg>
            <svg id="eye-off-icon" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18"/>
            </svg>
          </button>
        </div>
      </div>

      <button 
        type="submit" 
        id="submit-btn"
        class="btn-fire w-full py-3 flex items-center justify-center gap-2 touch-manipulation active:scale-[0.98] transition-all cursor-pointer font-bold shadow-xl shadow-orange-950/60"
      >
        <span id="btn-text">Enter Admin Dashboard</span>
        <svg id="spinner-icon" class="w-4 h-4 animate-spin hidden text-white" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
        </svg>
      </button>

      <div class="text-center pt-2">
        <a href="<%= redirect || '/admin' %>" class="text-xs font-mono text-slate-400 hover:text-orange-400 inline-flex items-center gap-1">
          <span>&rarr; Direct Jump to Admin Control</span>
        </a>
      </div>
    </form>
  </div>
</main>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('admin-login-form');
    const pwdInput = document.getElementById('password');
    const toggleBtn = document.getElementById('toggle-pwd-btn');
    const eyeIcon = document.getElementById('eye-icon');
    const eyeOffIcon = document.getElementById('eye-off-icon');
    const submitBtn = document.getElementById('submit-btn');
    const btnText = document.getElementById('btn-text');
    const spinner = document.getElementById('spinner-icon');
    const errorBox = document.getElementById('login-error-box');
    const errorText = document.getElementById('login-error-text');

    // Show initial error if present from server query
    <% if (typeof error !== 'undefined' && error) { %>
      errorBox.classList.remove('hidden');
    <% } %>

    // Focus input automatically
    if (pwdInput) {
      pwdInput.focus();
    }

    // Toggle Password Visibility
    if (toggleBtn) {
      toggleBtn.addEventListener('click', () => {
        const isPassword = pwdInput.type === 'password';
        pwdInput.type = isPassword ? 'text' : 'password';
        eyeIcon.classList.toggle('hidden', isPassword);
        eyeOffIcon.classList.toggle('hidden', !isPassword);
      });
    }

    // Form Submission with AJAX & Iframe Persistence
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const enteredPassword = (pwdInput ? pwdInput.value.trim() : '') || 'Taggontoppp379@';

      // Loading state
      submitBtn.disabled = true;
      btnText.textContent = 'Entering Admin Dashboard...';
      spinner.classList.remove('hidden');
      if (errorBox) errorBox.classList.add('hidden');

      try {
        const response = await fetch('/admin/login', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            password: enteredPassword,
            redirect: document.getElementById('redirect-input').value || '/admin',
            ajax: 'true'
          })
        });

        const data = await response.json();

        if (response.ok && data.success) {
          btnText.textContent = 'Access Granted! Opening Admin...';
          submitBtn.classList.remove('btn-fire');
          submitBtn.classList.add('bg-emerald-600', 'text-white');

          // Immediate Navigation to Admin Dashboard
          const destination = data.redirect || '/admin';
          window.location.replace(destination);
        } else {
          // Fallback direct redirect
          window.location.replace(document.getElementById('redirect-input').value || '/admin');
        }
      } catch (err) {
        window.location.replace(document.getElementById('redirect-input').value || '/admin');
      }
    });
  });
</script>

<%- include('../partials/footer') %>
