<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <%- include('../partials/flash') %>

  <div>
    <a href="/admin/tournaments" class="text-xs font-mono text-slate-400 hover:text-orange-400">&larr; Back to Tournaments</a>
    <h1 class="font-display text-4xl font-bold text-white tracking-wide mt-1">
      <%= tournament ? `Edit ${tournament.name}` : 'Start / Create New Tournament' %>
    </h1>
    <p class="text-slate-400 text-sm">Configure tournament banner poster, prize pool, tournament category, battle royale maps rotation, and match format details.</p>
  </div>

  <div class="glass-panel p-6 sm:p-8">
    <form action="<%= tournament ? `/admin/tournaments/${tournament.id}/edit` : '/admin/tournaments/new' %>" method="POST" enctype="multipart/form-data" class="space-y-6">
      
      <!-- Tournament Title & Type -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="sm:col-span-2">
          <label for="name" class="block text-xs font-mono text-slate-300 uppercase mb-1">Tournament Title *</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            value="<%= tournament ? tournament.name : '' %>"
            placeholder="e.g. FFWS Spring Invitational 2026"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm"
          >
        </div>

        <div>
          <label for="tournament_category" class="block text-xs font-mono text-slate-300 uppercase mb-1">Circuit Category *</label>
          <select 
            id="tournament_category" 
            name="is_official_tournament" 
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm"
          >
            <option value="true">Official Esports Circuit (Garena / FFWS)</option>
            <option value="false">Unofficial / Local Organizer Cup</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Game Mode -->
        <div>
          <label for="game_mode" class="block text-xs font-mono text-slate-300 uppercase mb-1">Game Mode</label>
          <input 
            type="text" 
            id="game_mode" 
            name="game_mode" 
            value="<%= tournament ? tournament.game_mode : 'Battle Royale Squad' %>"
            placeholder="Battle Royale Squad, Duo, Solo, Clash Squad"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm"
          >
        </div>

        <!-- Prize Pool -->
        <div>
          <label for="prize_pool" class="block text-xs font-mono text-slate-300 uppercase mb-1">Prize Pool (PP)</label>
          <input 
            type="text" 
            id="prize_pool" 
            name="prize_pool" 
            value="<%= tournament ? tournament.prize_pool : '$150,000' %>"
            placeholder="$150,000 or ₹1,00,000"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm font-mono"
          >
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Start Date -->
        <div>
          <label for="start_date" class="block text-xs font-mono text-slate-300 uppercase mb-1">Start Date</label>
          <input 
            type="date" 
            id="start_date" 
            name="start_date" 
            value="<%= tournament && tournament.start_date ? new Date(tournament.start_date).toISOString().split('T')[0] : '' %>"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm"
          >
        </div>

        <!-- End Date -->
        <div>
          <label for="end_date" class="block text-xs font-mono text-slate-300 uppercase mb-1">End Date</label>
          <input 
            type="date" 
            id="end_date" 
            name="end_date" 
            value="<%= tournament && tournament.end_date ? new Date(tournament.end_date).toISOString().split('T')[0] : '' %>"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm"
          >
        </div>

        <!-- Status -->
        <div>
          <label for="status" class="block text-xs font-mono text-slate-300 uppercase mb-1">Status</label>
          <select 
            id="status" 
            name="status" 
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm"
          >
            <option value="ongoing" <%= tournament && tournament.status === 'ongoing' ? 'selected' : '' %>>Ongoing / Live Active</option>
            <option value="completed" <%= tournament && tournament.status === 'completed' ? 'selected' : '' %>>Completed (Archived)</option>
            <option value="upcoming" <%= tournament && tournament.status === 'upcoming' ? 'selected' : '' %>>Upcoming</option>
          </select>
        </div>
      </div>

      <!-- Description & Format -->
      <div>
        <label for="description" class="block text-xs font-mono text-slate-300 uppercase mb-1">Tournament Description & Format Details</label>
        <textarea 
          id="description" 
          name="description" 
          rows="3"
          placeholder="The supreme Free Fire MAX championship tournament featuring TAGFREEFIREMAX contending for the global title. Point System: 12-9-8-7-6-5-4-3-2-1 + 1pt/Kill."
          class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm"
        ><%= tournament ? tournament.description : '' %></textarea>
      </div>

      <!-- Banner Upload & Custom Banner URL -->
      <div class="p-5 rounded-2xl bg-black/40 border border-white/10 space-y-4">
        <label class="block text-xs font-mono text-orange-400 uppercase font-bold">
          Tournament Hero Banner Poster
        </label>
        
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <img 
            id="banner-preview" 
            src="<%= tournament && tournament.banner_url ? tournament.banner_url : 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=1200&auto=format&fit=crop' %>" 
            alt="Banner Preview" 
            class="w-48 h-28 rounded-xl object-cover border border-white/20 shadow-lg"
          >
          
          <div class="space-y-3 flex-1">
            <div class="flex items-center gap-3">
              <label class="btn-glass cursor-pointer text-xs py-2.5 px-4">
                <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                Upload Poster Image
                <input type="file" name="banner" accept="image/*" class="hidden" data-preview-target="banner-preview">
              </label>
              <span class="text-xs text-slate-400">Auto-optimized with Sharp</span>
            </div>

            <div>
              <label for="banner_url_input" class="block text-[11px] font-mono text-slate-400 mb-1">Or direct Image URL:</label>
              <input 
                type="url" 
                id="banner_url_input" 
                name="banner_url_input" 
                value="<%= tournament ? tournament.banner_url : '' %>"
                placeholder="https://images.unsplash.com/photo-..."
                class="w-full px-3 py-1.5 rounded-lg bg-slate-900 border border-white/10 text-white text-xs placeholder-slate-600 focus:outline-none focus:border-orange-500 font-mono"
                oninput="if(this.value){ document.getElementById('banner-preview').src = this.value; }"
              >
            </div>
          </div>
        </div>
      </div>

      <% if (!tournament) { %>
        <!-- Match Selection 1-6 & All Free Fire Maps Selection (Auto-Save to History) -->
        <div class="p-6 rounded-2xl bg-black/40 border border-white/10 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-white/10 pb-3">
            <div>
              <span class="badge-official text-[10px] uppercase tracking-wider">Esports Match Setup</span>
              <h3 class="font-display text-lg font-bold text-white tracking-wide mt-0.5">
                Match Selection (1–6) & Map Rotation Setup
              </h3>
            </div>
            <span class="text-xs font-mono text-emerald-400 bg-emerald-500/10 px-2.5 py-1 rounded-md border border-emerald-500/30 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Auto-Saves to History with All Details
            </span>
          </div>

          <!-- Match Count Selection (1 to 6) -->
          <div class="space-y-3">
            <label class="block text-xs font-mono text-slate-300 uppercase font-bold">
              Select Number of Matches (1–6):
            </label>
            <div class="grid grid-cols-3 sm:grid-cols-7 gap-2">
              <label class="p-3 rounded-xl bg-slate-900 border border-white/15 text-center cursor-pointer hover:border-orange-500 transition-all has-[:checked]:border-orange-500 has-[:checked]:bg-orange-500/10">
                <input type="radio" name="initial_matches_count" value="0" class="sr-only" onchange="updateMatchRowsVisibility(0)">
                <span class="block font-display text-sm font-bold text-white">0</span>
                <span class="text-[10px] text-slate-400 font-mono">Manual</span>
              </label>
              <label class="p-3 rounded-xl bg-slate-900 border border-white/15 text-center cursor-pointer hover:border-orange-500 transition-all has-[:checked]:border-orange-500 has-[:checked]:bg-orange-500/10">
                <input type="radio" name="initial_matches_count" value="1" class="sr-only" onchange="updateMatchRowsVisibility(1)">
                <span class="block font-display text-sm font-bold text-white">1 Match</span>
                <span class="text-[10px] text-slate-400 font-mono">Bo1</span>
              </label>
              <label class="p-3 rounded-xl bg-slate-900 border border-white/15 text-center cursor-pointer hover:border-orange-500 transition-all has-[:checked]:border-orange-500 has-[:checked]:bg-orange-500/10">
                <input type="radio" name="initial_matches_count" value="2" class="sr-only" onchange="updateMatchRowsVisibility(2)">
                <span class="block font-display text-sm font-bold text-white">2 Matches</span>
                <span class="text-[10px] text-slate-400 font-mono">Bo2</span>
              </label>
              <label class="p-3 rounded-xl bg-slate-900 border border-white/15 text-center cursor-pointer hover:border-orange-500 transition-all has-[:checked]:border-orange-500 has-[:checked]:bg-orange-500/10">
                <input type="radio" name="initial_matches_count" value="3" class="sr-only" onchange="updateMatchRowsVisibility(3)">
                <span class="block font-display text-sm font-bold text-white">3 Matches</span>
                <span class="text-[10px] text-slate-400 font-mono">Bo3</span>
              </label>
              <label class="p-3 rounded-xl bg-slate-900 border border-white/15 text-center cursor-pointer hover:border-orange-500 transition-all has-[:checked]:border-orange-500 has-[:checked]:bg-orange-500/10">
                <input type="radio" name="initial_matches_count" value="4" class="sr-only" onchange="updateMatchRowsVisibility(4)">
                <span class="block font-display text-sm font-bold text-white">4 Matches</span>
                <span class="text-[10px] text-slate-400 font-mono">Bo4</span>
              </label>
              <label class="p-3 rounded-xl bg-slate-900 border border-white/15 text-center cursor-pointer hover:border-orange-500 transition-all has-[:checked]:border-orange-500 has-[:checked]:bg-orange-500/10">
                <input type="radio" name="initial_matches_count" value="5" class="sr-only" onchange="updateMatchRowsVisibility(5)">
                <span class="block font-display text-sm font-bold text-white">5 Matches</span>
                <span class="text-[10px] text-slate-400 font-mono">Bo5</span>
              </label>
              <label class="p-3 rounded-xl bg-slate-900 border border-white/15 text-center cursor-pointer hover:border-orange-500 transition-all has-[:checked]:border-orange-500 has-[:checked]:bg-orange-500/10">
                <input type="radio" name="initial_matches_count" value="6" checked class="sr-only" onchange="updateMatchRowsVisibility(6)">
                <span class="block font-display text-sm font-bold text-orange-400">6 Matches</span>
                <span class="text-[10px] text-orange-400/80 font-mono">Standard Day</span>
              </label>
            </div>
          </div>

          <!-- All Free Fire Maps Selector for Matches 1 to 6 -->
          <div class="space-y-4" id="match-rotation-configs">
            <div class="text-xs text-slate-300 font-mono flex items-center justify-between">
              <span>ASSIGN MAP TO EACH MATCH (1–6):</span>
              <span class="text-[11px] text-slate-400">All 7 Free Fire Maps available</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              
              <!-- Match 1 Map -->
              <div class="p-3.5 rounded-xl bg-slate-900/90 border border-white/10 space-y-1.5 match-slot-item" id="match-slot-1">
                <div class="flex items-center justify-between">
                  <span class="font-display text-sm font-bold text-white flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-orange-400"></span>
                    MATCH #1
                  </span>
                  <span class="text-[10px] font-mono text-slate-400">Game 1</span>
                </div>
                <select name="match_1_map" class="w-full px-3 py-1.5 rounded-lg bg-black/60 border border-white/15 text-white text-xs font-mono focus:border-orange-500 focus:outline-none">
                  <option value="Bermuda" selected>Bermuda (Standard)</option>
                  <option value="Purgatory">Purgatory</option>
                  <option value="Kalahari">Kalahari</option>
                  <option value="Alpine">Alpine</option>
                  <option value="Nexterra">Nexterra</option>
                  <option value="Bermuda Remastered">Bermuda Remastered</option>
                  <option value="Solaria">Solaria</option>
                </select>
              </div>

              <!-- Match 2 Map -->
              <div class="p-3.5 rounded-xl bg-slate-900/90 border border-white/10 space-y-1.5 match-slot-item" id="match-slot-2">
                <div class="flex items-center justify-between">
                  <span class="font-display text-sm font-bold text-white flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-orange-400"></span>
                    MATCH #2
                  </span>
                  <span class="text-[10px] font-mono text-slate-400">Game 2</span>
                </div>
                <select name="match_2_map" class="w-full px-3 py-1.5 rounded-lg bg-black/60 border border-white/15 text-white text-xs font-mono focus:border-orange-500 focus:outline-none">
                  <option value="Bermuda">Bermuda</option>
                  <option value="Purgatory" selected>Purgatory (Standard)</option>
                  <option value="Kalahari">Kalahari</option>
                  <option value="Alpine">Alpine</option>
                  <option value="Nexterra">Nexterra</option>
                  <option value="Bermuda Remastered">Bermuda Remastered</option>
                  <option value="Solaria">Solaria</option>
                </select>
              </div>

              <!-- Match 3 Map -->
              <div class="p-3.5 rounded-xl bg-slate-900/90 border border-white/10 space-y-1.5 match-slot-item" id="match-slot-3">
                <div class="flex items-center justify-between">
                  <span class="font-display text-sm font-bold text-white flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-orange-400"></span>
                    MATCH #3
                  </span>
                  <span class="text-[10px] font-mono text-slate-400">Game 3</span>
                </div>
                <select name="match_3_map" class="w-full px-3 py-1.5 rounded-lg bg-black/60 border border-white/15 text-white text-xs font-mono focus:border-orange-500 focus:outline-none">
                  <option value="Bermuda">Bermuda</option>
                  <option value="Purgatory">Purgatory</option>
                  <option value="Kalahari" selected>Kalahari (Standard)</option>
                  <option value="Alpine">Alpine</option>
                  <option value="Nexterra">Nexterra</option>
                  <option value="Bermuda Remastered">Bermuda Remastered</option>
                  <option value="Solaria">Solaria</option>
                </select>
              </div>

              <!-- Match 4 Map -->
              <div class="p-3.5 rounded-xl bg-slate-900/90 border border-white/10 space-y-1.5 match-slot-item" id="match-slot-4">
                <div class="flex items-center justify-between">
                  <span class="font-display text-sm font-bold text-white flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-orange-400"></span>
                    MATCH #4
                  </span>
                  <span class="text-[10px] font-mono text-slate-400">Game 4</span>
                </div>
                <select name="match_4_map" class="w-full px-3 py-1.5 rounded-lg bg-black/60 border border-white/15 text-white text-xs font-mono focus:border-orange-500 focus:outline-none">
                  <option value="Bermuda">Bermuda</option>
                  <option value="Purgatory">Purgatory</option>
                  <option value="Kalahari">Kalahari</option>
                  <option value="Alpine" selected>Alpine (Standard)</option>
                  <option value="Nexterra">Nexterra</option>
                  <option value="Bermuda Remastered">Bermuda Remastered</option>
                  <option value="Solaria">Solaria</option>
                </select>
              </div>

              <!-- Match 5 Map -->
              <div class="p-3.5 rounded-xl bg-slate-900/90 border border-white/10 space-y-1.5 match-slot-item" id="match-slot-5">
                <div class="flex items-center justify-between">
                  <span class="font-display text-sm font-bold text-white flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-orange-400"></span>
                    MATCH #5
                  </span>
                  <span class="text-[10px] font-mono text-slate-400">Game 5</span>
                </div>
                <select name="match_5_map" class="w-full px-3 py-1.5 rounded-lg bg-black/60 border border-white/15 text-white text-xs font-mono focus:border-orange-500 focus:outline-none">
                  <option value="Bermuda">Bermuda</option>
                  <option value="Purgatory">Purgatory</option>
                  <option value="Kalahari">Kalahari</option>
                  <option value="Alpine">Alpine</option>
                  <option value="Nexterra" selected>Nexterra (Standard)</option>
                  <option value="Bermuda Remastered">Bermuda Remastered</option>
                  <option value="Solaria">Solaria</option>
                </select>
              </div>

              <!-- Match 6 Map -->
              <div class="p-3.5 rounded-xl bg-slate-900/90 border border-white/10 space-y-1.5 match-slot-item" id="match-slot-6">
                <div class="flex items-center justify-between">
                  <span class="font-display text-sm font-bold text-white flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-orange-400"></span>
                    MATCH #6
                  </span>
                  <span class="text-[10px] font-mono text-slate-400">Game 6 (Grand Final)</span>
                </div>
                <select name="match_6_map" class="w-full px-3 py-1.5 rounded-lg bg-black/60 border border-white/15 text-white text-xs font-mono focus:border-orange-500 focus:outline-none">
                  <option value="Bermuda">Bermuda</option>
                  <option value="Purgatory">Purgatory</option>
                  <option value="Kalahari">Kalahari</option>
                  <option value="Alpine">Alpine</option>
                  <option value="Nexterra">Nexterra</option>
                  <option value="Bermuda Remastered" selected>Bermuda Remastered (Standard)</option>
                  <option value="Solaria">Solaria</option>
                </select>
              </div>

            </div>
          </div>

          <div class="p-3 rounded-lg bg-orange-500/10 border border-orange-500/20 text-xs text-slate-300 flex items-start gap-2">
            <svg class="w-4 h-4 text-orange-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p>
              When you create this tournament with 1–6 matches, full match ledgers, kills, points, and map analytics are automatically populated and saved to the <strong>Match History</strong> ledger and <strong>Map Analysis</strong> panel on the Home Page!
            </p>
          </div>
        </div>

        <script>
          function updateMatchRowsVisibility(count) {
            const container = document.getElementById('match-rotation-configs');
            if (!container) return;
            if (count === 0) {
              container.classList.add('opacity-40', 'pointer-events-none');
            } else {
              container.classList.remove('opacity-40', 'pointer-events-none');
              for (let i = 1; i <= 6; i++) {
                const el = document.getElementById('match-slot-' + i);
                if (el) {
                  if (i <= count) {
                    el.classList.remove('hidden');
                  } else {
                    el.classList.add('hidden');
                  }
                }
              }
            }
          }
        </script>
      <% } %>

      <!-- Set as Current Featured Tournament Toggle -->
      <div class="p-4 rounded-xl bg-orange-500/10 border border-orange-500/30 flex items-center justify-between">
        <div>
          <span class="font-bold text-sm text-white">Set as Current / Active Tournament</span>
          <p class="text-xs text-slate-400">Immediately features this tournament on the homepage banner, title box, and live scoreboard.</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" name="is_current" value="true" class="sr-only peer" <%= (!tournament || tournament.is_current) ? 'checked' : '' %>>
          <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-orange-500"></div>
        </label>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4 border-t border-white/10">
        <a href="/admin/tournaments" class="btn-glass text-xs py-2.5 px-4">Cancel</a>
        <button type="submit" class="btn-fire text-xs py-2.5 px-6">
          <%= tournament ? 'Update Tournament' : 'Start Tournament & Show on Hub' %>
        </button>
      </div>

    </form>
  </div>

</main>

<%- include('../partials/footer') %>
