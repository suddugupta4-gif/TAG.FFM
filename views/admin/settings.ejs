<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="flex-1 max-w-4xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <%- include('../partials/flash') %>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <a href="/admin" class="text-xs font-mono text-slate-400 hover:text-orange-400">&larr; Admin Dashboard</a>
      </div>
      <h1 class="font-display text-4xl font-bold text-white tracking-wide">Platform & Theme Settings</h1>
      <p class="text-slate-400 text-sm">Customize the global glassmorphism wallpaper and site branding.</p>
    </div>
  </div>

  <div class="glass-panel p-6 sm:p-8 space-y-10">
    
    <!-- 1. Squad & Website Logo (Navbar & Roster Page Synchronization) -->
    <div id="logo-section" class="space-y-6">
      <div class="flex items-center justify-between border-b border-white/10 pb-3">
        <div>
          <h2 class="font-display text-2xl font-bold text-white flex items-center gap-2">
            <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Squad & Website Logo (Navbar & Roster Sync)
          </h2>
          <p class="text-xs text-slate-400">Add or upload your squad logo. Changing this logo will automatically update the <strong>Top Navbar Logo</strong>, the <strong>Admin Dashboard</strong>, and the <strong>Roster Page (/teams)</strong> hero crest.</p>
        </div>

        <form action="<%= adminHref('/admin/settings/logo') %>" method="POST" class="inline">
          <input type="hidden" name="reset_logo" value="true">
          <button type="submit" class="text-xs font-mono text-slate-400 hover:text-orange-400 underline">
            Reset to Default Flame Emblem
          </button>
        </form>
      </div>

      <!-- Live Logo Previews (Navbar & Roster size) -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Preview on Navbar -->
        <div class="p-4 rounded-2xl bg-slate-900/80 border border-white/10 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-slate-300 uppercase">1. Preview on Top Navbar</span>
            <span class="text-[10px] font-mono text-emerald-400">Header Branding</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-950/90 border border-white/10 flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#ff4e00] to-orange-800 flex items-center justify-center shadow-lg shadow-[#ff4e00]/20 border border-white/15 overflow-hidden shrink-0">
              <img id="navLogoPreview" src="<%- currentLogo || '' %>" alt="Logo" class="w-full h-full object-cover <%= currentLogo ? '' : 'hidden' %>" onerror="this.classList.add('hidden'); document.getElementById('navLogoSvg').classList.remove('hidden');">
              <svg id="navLogoSvg" class="w-5 h-5 text-white <%= currentLogo ? 'hidden' : '' %>" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-1.5 font-display text-lg font-black tracking-wider text-[#ff4e00]">
                TAGFREEFIRE<span class="text-white">MAX</span>
              </div>
              <p class="text-[9px] text-gray-500 font-mono tracking-widest uppercase -mt-0.5">ESPORTS COMMAND CENTER</p>
            </div>
          </div>
        </div>

        <!-- Preview on Roster Hero -->
        <div class="p-4 rounded-2xl bg-slate-900/80 border border-orange-500/20 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-mono text-orange-400 uppercase font-bold">2. Preview on Roster Page (/teams)</span>
            <span class="text-[10px] font-mono text-orange-400">Squad Crest Badge</span>
          </div>
          <div class="p-3 rounded-xl bg-slate-950/90 border border-orange-500/30 flex items-center gap-4">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-gradient-to-br from-[#ff4e00] to-orange-950 border-2 border-orange-500/50 shadow-xl flex items-center justify-center overflow-hidden shrink-0">
              <img id="rosterLogoPreview" src="<%- currentLogo || '' %>" alt="Squad Crest" class="w-full h-full object-cover <%= currentLogo ? '' : 'hidden' %>" onerror="this.classList.add('hidden'); document.getElementById('rosterLogoSvg').classList.remove('hidden');">
              <svg id="rosterLogoSvg" class="w-8 h-8 sm:w-10 sm:h-10 text-white drop-shadow-md <%= currentLogo ? 'hidden' : '' %>" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
            <div class="space-y-1">
              <span class="badge-official font-mono text-[10px]">[TAG]</span>
              <p class="font-display text-base font-bold text-white leading-tight">TAGFREEFIREMAX</p>
              <p class="text-[11px] text-slate-400 font-mono">Official Roster & Squad Banner</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Upload Logo Form -->
      <form action="<%= adminHref('/admin/settings/logo') %>" method="POST" enctype="multipart/form-data" class="space-y-4">
        
        <!-- Method A: File Upload -->
        <div class="p-5 rounded-2xl bg-slate-900/80 border border-orange-500/25 space-y-3">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-mono text-orange-400 uppercase font-bold">1. Upload Logo Image File (From Computer / Mobile)</label>
            <span class="text-[11px] font-mono text-emerald-400">Sharp WebP Compression</span>
          </div>

          <div class="flex flex-col sm:flex-row items-center gap-4">
            <label class="btn-fire cursor-pointer text-xs py-3 px-6 flex items-center gap-2 w-full sm:w-auto justify-center font-bold">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span id="logoFileLabel">Choose Logo File (PNG / JPG / SVG / WEBP)</span>
              <input type="file" name="logo" id="logoFileInput" accept="image/*" class="hidden" onchange="previewLogoFile(this)">
            </label>
            <button type="submit" class="btn-glass text-xs py-3 px-6 w-full sm:w-auto text-white border-orange-500/40 hover:bg-orange-500/20 font-bold">
              Upload & Apply Everywhere
            </button>
          </div>
          <p class="text-[11px] text-slate-400">Square ratio (1:1) recommended. Supported formats: PNG with transparent background, SVG vector, JPG, or WebP.</p>
        </div>

        <!-- Method B: Direct Image URL -->
        <div class="space-y-2">
          <label for="settings_logo_url" class="block text-xs font-mono text-slate-300 uppercase">2. Or Paste Direct Image URL (Discord, Imgur, CDN, etc.)</label>
          <div class="flex gap-2">
            <input 
              type="text" 
              id="settings_logo_url" 
              name="logo_url" 
              value="<%= currentLogo || '' %>"
              placeholder="https://i.imgur.com/your-logo.png" 
              class="flex-1 px-4 py-2.5 rounded-xl bg-slate-900/90 border border-white/15 text-white font-mono text-xs focus:outline-none focus:border-orange-500"
              oninput="previewLogoUrl(this.value)"
            >
            <button type="submit" class="btn-glass text-xs py-2.5 px-5 font-bold">
              Save Logo URL
            </button>
          </div>
        </div>

        <!-- Method C: Preset Logos -->
        <div class="space-y-2 pt-2 border-t border-white/10">
          <label class="block text-xs font-mono text-slate-300 uppercase">3. Or Pick a Preset Esports Crest</label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <button 
              type="button" 
              onclick="applyLogoPreset('')"
              class="p-2.5 rounded-xl bg-slate-900/90 border border-white/10 hover:border-orange-500 text-left transition-all group flex items-center gap-3"
            >
              <div class="w-10 h-10 rounded-lg bg-gradient-to-br from-[#ff4e00] to-orange-900 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
              </div>
              <span class="text-xs font-mono text-slate-200 group-hover:text-orange-400 font-bold block truncate">TAG Layers (Default)</span>
            </button>

            <button 
              type="button" 
              onclick="applyLogoPreset('/favicon.svg')"
              class="p-2.5 rounded-xl bg-slate-900/90 border border-white/10 hover:border-orange-500 text-left transition-all group flex items-center gap-3"
            >
              <div class="w-10 h-10 rounded-lg bg-slate-950 flex items-center justify-center shrink-0 p-1 border border-orange-500/30">
                <img src="/favicon.svg" alt="TAG Shield" class="w-full h-full object-contain">
              </div>
              <span class="text-xs font-mono text-slate-200 group-hover:text-orange-400 font-bold block truncate">TAG Shield Crest</span>
            </button>

            <button 
              type="button" 
              onclick="applyLogoPreset('https://images.unsplash.com/photo-1578632767115-351597cf2477?q=80&w=300&auto=format&fit=crop')"
              class="p-2.5 rounded-xl bg-slate-900/90 border border-white/10 hover:border-orange-500 text-left transition-all group flex items-center gap-3"
            >
              <div class="w-10 h-10 rounded-lg bg-cover bg-center shrink-0 border border-white/10" style="background-image: url('https://images.unsplash.com/photo-1578632767115-351597cf2477?q=80&w=200&auto=format&fit=crop');"></div>
              <span class="text-xs font-mono text-slate-200 group-hover:text-orange-400 font-bold block truncate">Fire Tiger</span>
            </button>

            <button 
              type="button" 
              onclick="applyLogoPreset('https://images.unsplash.com/photo-1563089145-599997674d42?q=80&w=300&auto=format&fit=crop')"
              class="p-2.5 rounded-xl bg-slate-900/90 border border-white/10 hover:border-orange-500 text-left transition-all group flex items-center gap-3"
            >
              <div class="w-10 h-10 rounded-lg bg-cover bg-center shrink-0 border border-white/10" style="background-image: url('https://images.unsplash.com/photo-1563089145-599997674d42?q=80&w=200&auto=format&fit=crop');"></div>
              <span class="text-xs font-mono text-slate-200 group-hover:text-orange-400 font-bold block truncate">Cyber Neon</span>
            </button>
          </div>
        </div>

      </form>
    </div>
    
    <!-- 2. Background Wallpaper Upload & Management -->
    <div class="space-y-6 pt-6 border-t border-white/10">
      <div class="flex items-center justify-between border-b border-white/10 pb-3">
        <div>
          <h2 class="font-display text-2xl font-bold text-white flex items-center gap-2">
            <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Site Background Photo & Theme Wallpaper
          </h2>
          <p class="text-xs text-slate-400">Upload a custom high-res esports wallpaper. Processed via Sharp into compressed WebP and seamlessly rendered behind all frosted glass boxes.</p>
        </div>
      </div>

      <!-- Current Background Preview & Test Box -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono text-slate-300 uppercase">Active Wallpaper Live Preview</span>
          <form action="<%= adminHref('/admin/settings/background') %>" method="POST" class="inline">
            <input type="hidden" name="background_url" value="https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop">
            <button type="submit" class="text-xs font-mono text-slate-400 hover:text-orange-400 underline">
              Reset to Default Wallpaper
            </button>
          </form>
        </div>
        <div class="relative h-56 rounded-2xl overflow-hidden border border-white/20 bg-slate-950 flex items-center justify-center group shadow-2xl">
          <img id="settingsBgPreview" src="<%- currentBg || 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop' %>" alt="Current Wallpaper" class="w-full h-full object-cover">
          
          <!-- Demonstration Glass Box -->
          <div class="absolute inset-0 bg-slate-950/30 backdrop-blur-xs flex items-center justify-center p-6">
            <div class="glass p-4 rounded-xl border border-white/20 text-center max-w-sm w-full shadow-2xl space-y-1">
              <span class="badge-official text-[10px] py-0.5">ACTIVE WALLPAPER</span>
              <p class="font-display text-xl font-bold text-white">Glass UI Preview</p>
              <p class="text-xs text-slate-300">All player cards, tournaments, tables, and analysis boxes float over this photo.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Background Photo Options Form -->
      <form action="<%= adminHref('/admin/settings/background') %>" method="POST" enctype="multipart/form-data" class="space-y-5">
        
        <!-- Option A: File Upload -->
        <div class="p-5 rounded-2xl bg-slate-900/80 border border-orange-500/25 space-y-3">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-mono text-orange-400 uppercase font-bold">1. Upload Background Image File</label>
            <span class="text-[11px] font-mono text-emerald-400">Sharp WebP Compression</span>
          </div>
          
          <div class="flex flex-col sm:flex-row items-center gap-4">
            <label class="btn-fire cursor-pointer text-xs py-3 px-6 flex items-center gap-2 w-full sm:w-auto justify-center font-bold">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span id="settingsFileLabel">Choose Photo File (JPG / PNG / WEBP)</span>
              <input type="file" name="background" id="settingsBgFile" accept="image/*" class="hidden" onchange="previewSettingsFile(this)">
            </label>
            <button type="submit" class="btn-glass text-xs py-3 px-6 w-full sm:w-auto text-white border-orange-500/40 hover:bg-orange-500/20 font-bold">
              Upload & Save Wallpaper
            </button>
          </div>
          <p class="text-[11px] text-slate-400">Any resolution up to 4K is accepted. Image will be automatically resized, optimized, and compressed to WebP.</p>
        </div>

        <!-- Option B: Direct Image URL -->
        <div class="space-y-2">
          <label for="settings_bg_url" class="block text-xs font-mono text-slate-300 uppercase">2. Or Provide Direct Image URL</label>
          <div class="flex gap-2">
            <input 
              type="text" 
              id="settings_bg_url" 
              name="background_url" 
              value="<%= currentBg || '' %>"
              placeholder="https://images.unsplash.com/photo-..." 
              class="flex-1 px-4 py-2.5 rounded-xl bg-slate-900/90 border border-white/15 text-white font-mono text-xs focus:outline-none focus:border-orange-500"
              oninput="previewSettingsUrl(this.value)"
            >
            <button type="submit" class="btn-glass text-xs py-2.5 px-5 font-bold">
              Save URL
            </button>
          </div>
        </div>

        <!-- Option C: Presets Quick Select -->
        <div class="space-y-2 pt-2 border-t border-white/10">
          <label class="block text-xs font-mono text-slate-300 uppercase">3. Or Pick a Curated Esports Background Theme</label>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            <button 
              type="button" 
              onclick="applySettingsPreset('https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=2070&auto=format&fit=crop')"
              class="p-2.5 rounded-xl bg-slate-900/90 border border-white/10 hover:border-orange-500 text-left transition-all group"
            >
              <div class="h-14 rounded-lg bg-cover bg-center mb-1.5" style="background-image: url('https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=300&auto=format&fit=crop');"></div>
              <span class="text-xs font-mono text-slate-200 group-hover:text-orange-400 font-bold block truncate">Cyber Arena</span>
            </button>

            <button 
              type="button" 
              onclick="applySettingsPreset('https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=2070&auto=format&fit=crop')"
              class="p-2.5 rounded-xl bg-slate-900/90 border border-white/10 hover:border-orange-500 text-left transition-all group"
            >
              <div class="h-14 rounded-lg bg-cover bg-center mb-1.5" style="background-image: url('https://images.unsplash.com/photo-1511512578047-dfb367046420?q=80&w=300&auto=format&fit=crop');"></div>
              <span class="text-xs font-mono text-slate-200 group-hover:text-orange-400 font-bold block truncate">Neon Stadium</span>
            </button>

            <button 
              type="button" 
              onclick="applySettingsPreset('https://images.unsplash.com/photo-1538481199705-c710c4e965fc?q=80&w=2070&auto=format&fit=crop')"
              class="p-2.5 rounded-xl bg-slate-900/90 border border-white/10 hover:border-orange-500 text-left transition-all group"
            >
              <div class="h-14 rounded-lg bg-cover bg-center mb-1.5" style="background-image: url('https://images.unsplash.com/photo-1538481199705-c710c4e965fc?q=80&w=300&auto=format&fit=crop');"></div>
              <span class="text-xs font-mono text-slate-200 group-hover:text-orange-400 font-bold block truncate">Kalahari Battle</span>
            </button>

            <button 
              type="button" 
              onclick="applySettingsPreset('https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=2070&auto=format&fit=crop')"
              class="p-2.5 rounded-xl bg-slate-900/90 border border-white/10 hover:border-orange-500 text-left transition-all group"
            >
              <div class="h-14 rounded-lg bg-cover bg-center mb-1.5" style="background-image: url('https://images.unsplash.com/photo-1550745165-9bc0b252726f?q=80&w=300&auto=format&fit=crop');"></div>
              <span class="text-xs font-mono text-slate-200 group-hover:text-orange-400 font-bold block truncate">Dark Ember</span>
            </button>
          </div>
        </div>

      </form>
    </div>

    <!-- 2. General Settings -->
    <div class="space-y-4 pt-6 border-t border-white/10">
      <h2 class="font-display text-2xl font-bold text-white">Site Branding Information</h2>

      <form action="<%= adminHref('/admin/settings/general') %>" method="POST" class="space-y-4">
        <div>
          <label for="site_title" class="block text-xs font-mono text-slate-300 uppercase mb-1">Site Title</label>
          <input 
            type="text" 
            id="site_title" 
            name="site_title" 
            value="<%= typeof siteTitle !== 'undefined' ? siteTitle : (typeof settings !== 'undefined' && settings.site_title ? settings.site_title : 'TAGFREEFIREMAX') %>"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm font-semibold"
          >
        </div>

        <div>
          <label for="site_tagline" class="block text-xs font-mono text-slate-300 uppercase mb-1">Tagline</label>
          <input 
            type="text" 
            id="site_tagline" 
            name="site_tagline" 
            value="<%= typeof siteTagline !== 'undefined' ? siteTagline : (typeof settings !== 'undefined' && settings.site_tagline ? settings.site_tagline : 'Premier Free Fire MAX Esports Hub') %>"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm font-semibold"
          >
        </div>

        <button type="submit" class="btn-fire text-xs py-2.5 px-6 font-bold">
          Save Settings
        </button>
      </form>
    </div>

    <!-- 3. Visitor Counter Telemetry Customization -->
    <div id="visitor-counter" class="space-y-4 pt-6 border-t border-emerald-500/20">
      <div class="flex items-center gap-2 text-emerald-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <h2 class="font-display text-2xl font-bold text-white">Live Visitor Counter Telemetry</h2>
      </div>
      <p class="text-xs text-slate-400">
        The visitor counter displays live on the footer of every page. You can set the baseline or reset it to 0 at any time.
      </p>

      <form action="<%= adminHref('/admin/settings/visitors') %>" method="POST" class="space-y-4">
        <% if (typeof activeAdminToken !== 'undefined' && activeAdminToken) { %>
          <input type="hidden" name="admin_token" value="<%= activeAdminToken %>">
        <% } %>
        
        <div class="max-w-md">
          <label for="unique_visitors" class="block text-xs font-mono text-slate-300 uppercase mb-1">Unique Visitors Counter</label>
          <div class="flex items-center gap-3">
            <input 
              type="number" 
              id="unique_visitors" 
              name="unique_visitors" 
              value="<%= locals.visitorsCount || 0 %>"
              min="0"
              class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-emerald-500 font-mono text-sm font-semibold"
            >
            <button 
              type="button" 
              onclick="document.getElementById('unique_visitors').value = '0';"
              class="px-4 py-2.5 rounded-xl bg-red-500/20 text-red-400 hover:bg-red-500/30 border border-red-500/30 text-xs font-mono font-bold whitespace-nowrap transition-colors"
              title="Set input value to 0"
            >
              Set to 0
            </button>
          </div>
          <p class="text-[11px] text-slate-400 mt-1">Increments automatically when a new unique visitor visits the site.</p>
        </div>

        <div class="flex items-center gap-3">
          <button type="submit" class="btn-glass text-xs py-2.5 px-6 font-bold text-emerald-400 hover:text-white border-emerald-500/40 hover:bg-emerald-500/20">
            Save Visitor Counter
          </button>
        </div>
      </form>
    </div>

    <!-- 4. Fresh Restart & Database Reset Zone -->
    <div class="space-y-4 pt-6 border-t border-red-500/20">
      <div class="flex items-center gap-2 text-red-400">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
        <h2 class="font-display text-2xl font-bold text-white">Restart Fresh Website / Zero Out All Details</h2>
      </div>
      <p class="text-xs text-slate-400">
        This will wipe out all ongoing and past tournaments, matches, and match player scorecards, resetting all career and tournament statistics across the entire website to 0 so you can start completely fresh.
      </p>

      <form action="<%= adminHref('/admin/settings/reset-database') %>" method="POST" onsubmit="return confirm('Are you sure you want to reset all website data to 0? All tournaments, matches, and stats will be cleared.')">
        <% if (typeof activeAdminToken !== 'undefined' && activeAdminToken) { %>
          <input type="hidden" name="admin_token" value="<%= activeAdminToken %>">
        <% } %>
        <button type="submit" class="py-2.5 px-5 rounded-xl bg-red-600/20 hover:bg-red-600/40 text-red-300 hover:text-white border border-red-500/40 text-xs font-mono font-bold transition-all flex items-center gap-2 cursor-pointer active:scale-95">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
          </svg>
          Reset All Tournaments & Matches to 0
        </button>
      </form>
    </div>

  </div>

  <script>
    function previewLogoFile(input) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        const reader = new FileReader();
        reader.onload = function(e) {
          const result = e.target.result;
          const navImg = document.getElementById('navLogoPreview');
          const navSvg = document.getElementById('navLogoSvg');
          const rosterImg = document.getElementById('rosterLogoPreview');
          const rosterSvg = document.getElementById('rosterLogoSvg');

          if (navImg) { navImg.src = result; navImg.classList.remove('hidden'); }
          if (navSvg) { navSvg.classList.add('hidden'); }
          if (rosterImg) { rosterImg.src = result; rosterImg.classList.remove('hidden'); }
          if (rosterSvg) { rosterSvg.classList.add('hidden'); }
        };
        reader.readAsDataURL(file);
        const label = document.getElementById('logoFileLabel');
        if (label) label.textContent = file.name;
      }
    }

    function previewLogoUrl(url) {
      const trimmed = (url || '').trim();
      const navImg = document.getElementById('navLogoPreview');
      const navSvg = document.getElementById('navLogoSvg');
      const rosterImg = document.getElementById('rosterLogoPreview');
      const rosterSvg = document.getElementById('rosterLogoSvg');

      if (trimmed) {
        if (navImg) { navImg.src = trimmed; navImg.classList.remove('hidden'); }
        if (navSvg) { navSvg.classList.add('hidden'); }
        if (rosterImg) { rosterImg.src = trimmed; rosterImg.classList.remove('hidden'); }
        if (rosterSvg) { rosterSvg.classList.add('hidden'); }
      } else {
        if (navImg) { navImg.classList.add('hidden'); }
        if (navSvg) { navSvg.classList.remove('hidden'); }
        if (rosterImg) { rosterImg.classList.add('hidden'); }
        if (rosterSvg) { rosterSvg.classList.remove('hidden'); }
      }
    }

    function applyLogoPreset(url) {
      const urlInput = document.getElementById('settings_logo_url');
      if (urlInput) urlInput.value = url;
      previewLogoUrl(url);
    }

    function previewSettingsFile(input) {
      if (input.files && input.files[0]) {
        const file = input.files[0];
        const reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('settingsBgPreview').src = e.target.result;
          const bgLayer = document.querySelector('.site-bg-layer');
          if (bgLayer) bgLayer.style.backgroundImage = `url("${e.target.result}")`;
        };
        reader.readAsDataURL(file);
        const label = document.getElementById('settingsFileLabel');
        if (label) label.textContent = file.name;
      }
    }

    function previewSettingsUrl(url) {
      if (url && url.trim().startsWith('http')) {
        document.getElementById('settingsBgPreview').src = url.trim();
        const bgLayer = document.querySelector('.site-bg-layer');
        if (bgLayer) bgLayer.style.backgroundImage = `url("${url.trim()}")`;
      }
    }

    function applySettingsPreset(url) {
      const urlInput = document.getElementById('settings_bg_url');
      if (urlInput) urlInput.value = url;
      previewSettingsUrl(url);
    }
  </script>

</main>

<%- include('../partials/footer') %>
