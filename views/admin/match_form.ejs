<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <%- include('../partials/flash') %>

  <div>
    <a href="/admin/matches?tournament_id=<%= selectedTourneyId %>" class="text-xs font-mono text-slate-400 hover:text-orange-400">&larr; Back to Matches</a>
    <h1 class="font-display text-4xl font-bold text-white tracking-wide mt-1">Log Match Results & Scoreboard</h1>
    <p class="text-slate-400 text-sm">Enter team placements and frags. Points are auto-calculated and linked to official or unofficial leaderboards.</p>
  </div>

  <form action="/admin/matches/new" method="POST" class="space-y-8">
    
    <!-- Match Metadata Card -->
    <div class="glass-panel p-6 space-y-6">
      <h2 class="font-display text-2xl font-bold text-white">1. Match Details</h2>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <!-- Tournament -->
        <div>
          <label for="tournament_id" class="block text-xs font-mono text-slate-300 uppercase mb-1">Tournament *</label>
          <select 
            id="tournament_id" 
            name="tournament_id" 
            required 
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm"
          >
            <% tournaments.forEach(t => { %>
              <option value="<%= t.id %>" <%= t.id === selectedTourneyId ? 'selected' : '' %>>
                <%= t.name %> <%= t.is_current ? '(Current)' : '' %>
              </option>
            <% }); %>
          </select>
        </div>

        <!-- Match Number -->
        <div>
          <label for="match_number" class="block text-xs font-mono text-slate-300 uppercase mb-1">Match Number *</label>
          <input 
            type="number" 
            id="match_number" 
            name="match_number" 
            required 
            min="1" 
            value="<%= nextMatchNumber %>"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm font-mono"
          >
        </div>

        <!-- Map Name -->
        <div>
          <label for="map_name" class="block text-xs font-mono text-slate-300 uppercase mb-1">Battle Royale Map *</label>
          <select 
            id="map_name" 
            name="map_name" 
            required 
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm font-mono"
          >
            <option value="Bermuda">Bermuda</option>
            <option value="Purgatory">Purgatory</option>
            <option value="Kalahari">Kalahari</option>
            <option value="Alpine">Alpine</option>
            <option value="Nexterra">Nexterra</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <!-- Date -->
        <div>
          <label for="played_at" class="block text-xs font-mono text-slate-300 uppercase mb-1">Match Date & Time</label>
          <input 
            type="datetime-local" 
            id="played_at" 
            name="played_at" 
            value="<%= new Date().toISOString().slice(0, 16) %>"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm"
          >
        </div>

        <!-- Notes -->
        <div>
          <label for="notes" class="block text-xs font-mono text-slate-300 uppercase mb-1">Round Notes / Stream Tag</label>
          <input 
            type="text" 
            id="notes" 
            name="notes" 
            placeholder="e.g. Day 2 Grand Finals Match 1"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm"
          >
        </div>
      </div>

      <!-- Official Lock Verification Status -->
      <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-between">
        <div>
          <span class="font-bold text-sm text-emerald-300 flex items-center gap-1.5">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Mark as Verified Official Match
          </span>
          <p class="text-xs text-slate-400">If checked, stats count towards Official Verified standings. If unchecked, marked as Unofficial/Live provisional scoreboard.</p>
        </div>
        <label class="relative inline-flex items-center cursor-pointer">
          <input type="checkbox" name="is_official" value="true" checked class="sr-only peer">
          <div class="w-11 h-6 bg-slate-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-emerald-500"></div>
        </label>
      </div>
    </div>

    <!-- Team Scoreboard Results Table -->
    <div class="glass-panel p-6 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="font-display text-2xl font-bold text-white">2. Team Placements & Kills</h2>
          <p class="text-xs text-slate-400">Standard Free Fire point system: #1 = 12pts + kills, #2 = 9pts, #3 = 8pts, #4 = 7pts, #5 = 6pts, #6 = 5pts, #7 = 4pts, #8 = 3pts, #9 = 2pts, #10 = 1pt.</p>
        </div>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-xs font-mono text-left">
          <thead class="text-slate-400 border-b border-white/10 uppercase">
            <tr>
              <th class="py-2 px-2">Team</th>
              <th class="py-2 px-2 w-32">Placement (#)</th>
              <th class="py-2 px-2 w-32">Kills</th>
              <th class="py-2 px-2 text-right">Preview Points</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/5">
            <% teams.forEach((t, index) => { %>
              <tr class="hover:bg-white/5">
                <td class="py-2.5 px-2">
                  <div class="flex items-center gap-2">
                    <input type="hidden" name="team_id" value="<%= t.id %>">
                    <img src="<%= t.logo_url %>" alt="" class="w-6 h-6 rounded object-cover bg-slate-800" onerror="this.style.display='none'">
                    <span class="font-sans font-bold text-white text-sm"><%= t.name %></span>
                    <span class="text-orange-400 text-xs font-mono">[<%= t.tag %>]</span>
                  </div>
                </td>
                <td class="py-2 px-2">
                  <input 
                    type="number" 
                    name="placement" 
                    min="1" 
                    max="12" 
                    value="<%= index + 1 %>"
                    class="score-placement-input w-24 px-2.5 py-1.5 rounded-lg bg-slate-900 border border-white/15 text-white font-bold text-center focus:border-orange-500 focus:outline-none"
                  >
                </td>
                <td class="py-2 px-2">
                  <input 
                    type="number" 
                    name="kills" 
                    min="0" 
                    value="0" 
                    class="score-kills-input w-24 px-2.5 py-1.5 rounded-lg bg-slate-900 border border-white/15 text-white font-bold text-center focus:border-orange-500 focus:outline-none"
                  >
                </td>
                <td class="py-2 px-2 text-right font-display text-lg font-bold text-amber-400 score-preview">
                  --
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Submit Buttons -->
    <div class="flex items-center justify-end gap-4">
      <a href="/admin/matches?tournament_id=<%= selectedTourneyId %>" class="btn-glass">Cancel</a>
      <button type="submit" class="btn-fire px-8 py-3">
        Save & Calculate Match Scoreboard
      </button>
    </div>

  </form>

</main>

<script>
  // Point system calculator preview
  const placementPointsMap = { 1: 12, 2: 9, 3: 8, 4: 7, 5: 6, 6: 5, 7: 4, 8: 3, 9: 2, 10: 1 };
  function updateScores() {
    document.querySelectorAll('tbody tr').forEach(row => {
      const placementInput = row.querySelector('.score-placement-input');
      const killsInput = row.querySelector('.score-kills-input');
      const preview = row.querySelector('.score-preview');
      if (placementInput && killsInput && preview) {
        const place = parseInt(placementInput.value) || 0;
        const kills = parseInt(killsInput.value) || 0;
        const placePts = placementPointsMap[place] || 0;
        const total = placePts + kills;
        preview.textContent = `${total} PTS (${placePts} + ${kills}K)`;
      }
    });
  }
  document.querySelectorAll('.score-placement-input, .score-kills-input').forEach(input => {
    input.addEventListener('input', updateScores);
  });
  updateScores();
</script>

<%- include('../partials/footer') %>
