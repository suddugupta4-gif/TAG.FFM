<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <%- include('../partials/flash') %>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <a href="/admin" class="text-xs font-mono text-slate-400 hover:text-orange-400">&larr; Admin Dashboard</a>
      </div>
      <h1 class="font-display text-4xl font-bold text-white tracking-wide">Player Cards & Roster Management</h1>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Add Player Form -->
    <div class="glass-panel p-6 space-y-6">
      <h2 class="font-display text-2xl font-bold text-white">Add Pro Player</h2>
      
      <form action="/admin/players/new" method="POST" enctype="multipart/form-data" class="space-y-4" id="addPlayerForm">
        <!-- Team -->
        <div>
          <label for="team_id" class="block text-xs font-mono text-slate-300 uppercase mb-1">Squad / Team *</label>
          <select 
            id="team_id" 
            name="team_id" 
            required 
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm"
          >
            <% teams.forEach(t => { %>
              <option value="<%= t.id %>"><%= t.name %> [<%= t.tag %>]</option>
            <% }); %>
          </select>
        </div>

        <!-- In-Game Name -->
        <div>
          <label for="in_game_name" class="block text-xs font-mono text-slate-300 uppercase mb-1">In-Game Name (IGN) *</label>
          <input 
            type="text" 
            id="in_game_name" 
            name="in_game_name" 
            required 
            placeholder="e.g. MR05, Rasyah, AbaaaX"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm font-bold"
          >
        </div>

        <!-- Real Name -->
        <div>
          <label for="name" class="block text-xs font-mono text-slate-300 uppercase mb-1">Full / Real Name</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            placeholder="e.g. Regi Pratama"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm"
          >
        </div>

        <div class="grid grid-cols-2 gap-3">
          <!-- Role -->
          <div>
            <label for="role" class="block text-xs font-mono text-slate-300 uppercase mb-1">Role</label>
            <select 
              id="role" 
              name="role" 
              class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm font-mono"
            >
              <option value="Rusher">Rusher</option>
              <option value="IGL">IGL (Captain)</option>
              <option value="Sniper">Sniper</option>
              <option value="Support">Support</option>
              <option value="Flanker">Flanker</option>
            </select>
          </div>

          <!-- Free Fire UID -->
          <div>
            <label for="free_fire_uid" class="block text-xs font-mono text-slate-300 uppercase mb-1">Free Fire UID</label>
            <input 
              type="text" 
              id="free_fire_uid" 
              name="free_fire_uid" 
              placeholder="e.g. 182939102"
              class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm font-mono"
            >
          </div>
        </div>

        <!-- Photo Upload with Live Preview & Sharp Compression -->
        <div class="space-y-2">
          <label class="block text-xs font-mono text-slate-300 uppercase">Player Photo (Auto-compressed to WebP)</label>
          <div class="flex items-center gap-3">
            <img id="newPlayerPreview" src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=300&auto=format&fit=crop" alt="Preview" class="w-12 h-12 rounded-xl object-cover border border-white/20 bg-slate-800 shrink-0">
            <div class="flex-1">
              <label class="btn-glass w-full cursor-pointer text-xs py-2 justify-center flex items-center gap-2 hover:border-orange-500/50">
                <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span id="newPlayerFileName">Choose Photo File</span>
                <input type="file" name="avatar" id="newPlayerFileInput" accept="image/*" class="hidden" onchange="previewImage(this, 'newPlayerPreview', 'newPlayerFileName')">
              </label>
            </div>
          </div>
        </div>

        <button type="submit" class="btn-fire w-full py-3 mt-2">
          Register Player Card
        </button>
      </form>
    </div>

    <!-- Players Table -->
    <div class="lg:col-span-2 glass-panel p-6 space-y-4">
      <div class="flex items-center justify-between border-b border-white/10 pb-3">
        <h2 class="font-display text-2xl font-bold text-white">Registered Pro Players (<%= players.length %>)</h2>
      </div>

      <div class="overflow-x-auto">
        <table class="glass-table">
          <thead>
            <tr>
              <th>Player & Photo</th>
              <th>Team</th>
              <th class="text-center">Role</th>
              <th class="text-center">UID</th>
              <th class="text-right">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% players.forEach(p => { 
              const playerId = p.id || p.player_id;
              const playerName = p.name || p.player_name;
              const teamId = p.team_id || '';
              const role = p.role || 'Rusher';
              const uid = p.free_fire_uid || '';
              const avatar = p.avatar_url || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=300&auto=format&fit=crop';
            %>
              <tr class="table-row">
                <td>
                  <div class="flex items-center gap-3">
                    <div class="relative group/avatar shrink-0">
                      <img src="<%= avatar %>" alt="<%= p.in_game_name %>" class="w-11 h-11 rounded-xl object-cover bg-slate-800 border border-white/10 group-hover/avatar:border-orange-500/60 transition-all" onerror="this.src='https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=300&auto=format&fit=crop'">
                      <button 
                        type="button" 
                        onclick="openEditPlayerModal('<%= playerId %>', '<%= p.in_game_name %>', '<%= playerName %>', '<%= teamId %>', '<%= role %>', '<%= uid %>', '<%= avatar %>')"
                        class="absolute inset-0 bg-black/60 rounded-xl opacity-0 group-hover/avatar:opacity-100 flex items-center justify-center transition-opacity text-white text-[10px] font-bold"
                        title="Click to change photo"
                      >
                        <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                      </button>
                    </div>
                    <div>
                      <a href="/player/<%= playerId %>" class="font-bold text-white hover:text-orange-400 text-sm">
                        <%= p.in_game_name %>
                      </a>
                      <p class="text-xs text-slate-400"><%= playerName %></p>
                    </div>
                  </div>
                </td>
                <td class="text-xs font-mono text-slate-300">
                  <span class="badge-official text-[10px]"><%= p.team_tag %></span>
                  <%= p.team_name %>
                </td>
                <td class="text-center text-xs font-mono text-slate-400"><%= p.role %></td>
                <td class="text-center text-xs font-mono text-slate-500"><%= p.free_fire_uid || 'N/A' %></td>
                <td class="text-right">
                  <div class="inline-flex items-center gap-2">
                    <button 
                      type="button" 
                      onclick="openEditPlayerModal('<%= playerId %>', '<%= p.in_game_name %>', '<%= playerName %>', '<%= teamId %>', '<%= role %>', '<%= uid %>', '<%= avatar %>')"
                      class="btn-glass text-xs py-1 px-2.5 text-orange-400 hover:text-white hover:border-orange-500/50 flex items-center gap-1.5"
                    >
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                      Change Photo / Edit
                    </button>
                    <a href="/player/<%= playerId %>" class="btn-glass text-xs py-1 px-2">
                      View
                    </a>
                    <form action="/admin/players/<%= playerId %>/delete" method="POST" onsubmit="return confirm('Delete player <%= p.in_game_name %>?');" class="inline">
                      <button type="submit" class="btn-glass text-xs py-1 px-2 text-red-400 hover:bg-red-500/20" title="Delete">
                        &times;
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

  </div>

  <!-- Edit Player & Upload Photo Modal -->
  <div id="editPlayerModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="glass-panel max-w-lg w-full p-6 space-y-6 border border-orange-500/30 relative animate-smooth-in shadow-2xl bg-slate-950">
      
      <!-- Close Button -->
      <button type="button" onclick="closeEditPlayerModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-2xl font-bold w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/10 transition-colors">
        &times;
      </button>

      <div class="border-b border-white/10 pb-3">
        <h3 class="font-display text-2xl font-bold text-white flex items-center gap-2">
          <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Upload Photo & Edit Player
        </h3>
        <p class="text-xs text-slate-400 mt-1">Upload a new photo file (compressed with Sharp) or modify roster card details.</p>
      </div>

      <form id="editPlayerForm" method="POST" enctype="multipart/form-data" class="space-y-4">
        
        <!-- Photo Upload Box with Live Preview -->
        <div class="p-4 rounded-xl bg-slate-900/90 border border-orange-500/20 space-y-3">
          <label class="block text-xs font-mono text-orange-400 uppercase font-bold">Player Photo / Avatar</label>
          <div class="flex items-center gap-4">
            <div class="relative shrink-0">
              <img id="editPlayerAvatarPreview" src="" alt="Avatar Preview" class="w-20 h-20 rounded-2xl object-cover border-2 border-orange-500/50 shadow-md bg-slate-800" onerror="this.src='https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=300&auto=format&fit=crop'">
            </div>
            <div class="flex-1 space-y-2">
              <label class="btn-fire w-full cursor-pointer text-xs py-2.5 justify-center flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span id="editPlayerFileName">Upload New Photo</span>
                <input type="file" name="avatar" id="editPlayerFileInput" accept="image/*" class="hidden" onchange="previewImage(this, 'editPlayerAvatarPreview', 'editPlayerFileName')">
              </label>
              <p class="text-[11px] font-mono text-slate-400">JPG, PNG, WebP supported. Auto-compressed.</p>
            </div>
          </div>
          
          <div>
            <label for="edit_avatar_url" class="block text-[11px] font-mono text-slate-400 mb-1">Or Direct Photo URL:</label>
            <input 
              type="text" 
              id="edit_avatar_url" 
              name="avatar_url" 
              placeholder="https://..." 
              class="w-full px-3 py-1.5 rounded-lg bg-black/40 border border-white/10 text-white text-xs font-mono placeholder-slate-600 focus:outline-none focus:border-orange-500"
              oninput="document.getElementById('editPlayerAvatarPreview').src = this.value || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=300&auto=format&fit=crop'"
            >
          </div>
        </div>

        <!-- Team Selector -->
        <div>
          <label for="edit_team_id" class="block text-xs font-mono text-slate-300 uppercase mb-1">Squad / Team</label>
          <select 
            id="edit_team_id" 
            name="team_id" 
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm"
          >
            <% teams.forEach(t => { %>
              <option value="<%= t.id %>"><%= t.name %> [<%= t.tag %>]</option>
            <% }); %>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <!-- IGN -->
          <div>
            <label for="edit_in_game_name" class="block text-xs font-mono text-slate-300 uppercase mb-1">In-Game Name *</label>
            <input 
              type="text" 
              id="edit_in_game_name" 
              name="in_game_name" 
              required 
              class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-white/15 text-white text-sm font-bold focus:outline-none focus:border-orange-500"
            >
          </div>

          <!-- Real Name -->
          <div>
            <label for="edit_name" class="block text-xs font-mono text-slate-300 uppercase mb-1">Real Name</label>
            <input 
              type="text" 
              id="edit_name" 
              name="name" 
              class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-white/15 text-white text-sm focus:outline-none focus:border-orange-500"
            >
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <!-- Role -->
          <div>
            <label for="edit_role" class="block text-xs font-mono text-slate-300 uppercase mb-1">Role</label>
            <select 
              id="edit_role" 
              name="role" 
              class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-white/15 text-white text-sm font-mono focus:outline-none focus:border-orange-500"
            >
              <option value="Rusher">Rusher</option>
              <option value="IGL">IGL (Captain)</option>
              <option value="Sniper">Sniper</option>
              <option value="Support">Support</option>
              <option value="Flanker">Flanker</option>
            </select>
          </div>

          <!-- Free Fire UID -->
          <div>
            <label for="edit_free_fire_uid" class="block text-xs font-mono text-slate-300 uppercase mb-1">Free Fire UID</label>
            <input 
              type="text" 
              id="edit_free_fire_uid" 
              name="free_fire_uid" 
              class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-white/15 text-white text-sm font-mono focus:outline-none focus:border-orange-500"
            >
          </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button type="button" onclick="closeEditPlayerModal()" class="btn-glass flex-1 py-3 text-sm">
            Cancel
          </button>
          <button type="submit" class="btn-fire flex-1 py-3 text-sm">
            Save & Update Photo
          </button>
        </div>

      </form>
    </div>
  </div>

</main>

<script>
  function previewImage(input, previewImgId, labelTextId) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const reader = new FileReader();
      reader.onload = function(e) {
        const previewImg = document.getElementById(previewImgId);
        if (previewImg) previewImg.src = e.target.result;
      };
      reader.readAsDataURL(file);

      if (labelTextId) {
        const labelText = document.getElementById(labelTextId);
        if (labelText) labelText.textContent = file.name.length > 18 ? file.name.substring(0, 15) + '...' : file.name;
      }
    }
  }

  function openEditPlayerModal(id, ign, name, teamId, role, uid, avatarUrl) {
    const modal = document.getElementById('editPlayerModal');
    const form = document.getElementById('editPlayerForm');
    
    form.action = `/admin/players/${id}/edit`;
    document.getElementById('edit_in_game_name').value = ign || '';
    document.getElementById('edit_name').value = name || '';
    document.getElementById('edit_team_id').value = teamId || '';
    document.getElementById('edit_role').value = role || 'Rusher';
    document.getElementById('edit_free_fire_uid').value = uid || '';
    document.getElementById('edit_avatar_url').value = avatarUrl || '';
    document.getElementById('editPlayerAvatarPreview').src = avatarUrl || 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=300&auto=format&fit=crop';
    document.getElementById('editPlayerFileName').textContent = 'Upload New Photo';
    document.getElementById('editPlayerFileInput').value = '';

    modal.classList.remove('hidden');
  }

  function closeEditPlayerModal() {
    const modal = document.getElementById('editPlayerModal');
    modal.classList.add('hidden');
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeEditPlayerModal();
    }
  });

  document.addEventListener('DOMContentLoaded', function() {
    <% if (typeof openEditId !== 'undefined' && openEditId && typeof targetPlayer !== 'undefined' && targetPlayer) { %>
      openEditPlayerModal(
        '<%= targetPlayer.player_id || targetPlayer.id %>',
        '<%= (targetPlayer.in_game_name || "").replace(/\'/g, "\\\'") %>',
        '<%= (targetPlayer.player_name || targetPlayer.name || "").replace(/\'/g, "\\\'") %>',
        '<%= targetPlayer.team_id || "" %>',
        '<%= targetPlayer.role || "Rusher" %>',
        '<%= targetPlayer.free_fire_uid || "" %>',
        '<%= (targetPlayer.avatar_url || "").replace(/\'/g, "\\\'") %>'
      );
    <% } %>
  });
</script>

</main>

<%- include('../partials/footer') %>
