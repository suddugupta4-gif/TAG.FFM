<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <%- include('../partials/flash') %>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <div class="flex items-center gap-2">
        <a href="/admin" class="text-xs font-mono text-slate-400 hover:text-orange-400">&larr; Admin Dashboard</a>
      </div>
      <h1 class="font-display text-4xl font-bold text-white tracking-wide">Teams & Rosters Management</h1>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Add New Team Form -->
    <div class="glass-panel p-6 space-y-6">
      <h2 class="font-display text-2xl font-bold text-white">Register New Team</h2>
      
      <form action="/admin/teams/new" method="POST" enctype="multipart/form-data" class="space-y-4" id="addTeamForm">
        <div>
          <label for="name" class="block text-xs font-mono text-slate-300 uppercase mb-1">Team Name *</label>
          <input 
            type="text" 
            id="name" 
            name="name" 
            required 
            placeholder="e.g. EVOS Esports"
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm"
          >
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="tag" class="block text-xs font-mono text-slate-300 uppercase mb-1">Tag (Short Code) *</label>
            <input 
              type="text" 
              id="tag" 
              name="tag" 
              required 
              placeholder="EVOS"
              class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm font-mono uppercase"
            >
          </div>
          <div>
            <label for="country" class="block text-xs font-mono text-slate-300 uppercase mb-1">Country / Region</label>
            <input 
              type="text" 
              id="country" 
              name="country" 
              value="Indonesia"
              class="w-full px-4 py-2.5 rounded-xl bg-slate-900/80 border border-white/15 text-white placeholder-slate-500 focus:outline-none focus:border-orange-500 text-sm"
            >
          </div>
        </div>

        <!-- Logo Upload with Live Preview & Direct URL -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label class="block text-xs font-mono text-slate-300 uppercase">Team Logo (File or URL)</label>
            <span class="text-[10px] font-mono text-orange-400">Auto-Cloudinary / WebP</span>
          </div>
          <div class="flex items-start gap-3">
            <img id="newTeamLogoPreview" src="https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=200&auto=format&fit=crop" alt="Preview" class="w-14 h-14 rounded-xl object-cover border border-white/20 bg-slate-800 shrink-0 mt-1" onerror="this.src='https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=200&auto=format&fit=crop'">
            <div class="flex-1 space-y-2">
              <label class="btn-glass w-full cursor-pointer text-xs py-2 justify-center flex items-center gap-2 hover:border-orange-500/50">
                <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span id="newTeamLogoName">Choose Logo File</span>
                <input type="file" name="logo" id="newTeamFileInput" accept="image/*" class="hidden" onchange="previewImage(this, 'newTeamLogoPreview', 'newTeamLogoName')">
              </label>
              <input 
                type="url" 
                name="logo_url_input" 
                id="new_logo_url_input"
                placeholder="Or paste direct image URL (https://...)" 
                class="w-full px-3 py-1.5 rounded-lg bg-slate-900 border border-white/10 text-white text-xs font-mono placeholder-slate-500 focus:outline-none focus:border-orange-500"
                oninput="if(this.value){document.getElementById('newTeamLogoPreview').src=this.value;}"
              >
            </div>
          </div>
        </div>

        <button type="submit" class="btn-fire w-full py-3 mt-2">
          Create Team
        </button>
      </form>
    </div>

    <!-- Teams List -->
    <div class="lg:col-span-2 glass-panel p-6 space-y-4">
      <div class="flex items-center justify-between border-b border-white/10 pb-3">
        <h2 class="font-display text-2xl font-bold text-white">Registered Teams (<%= teams.length %>)</h2>
      </div>

      <div class="space-y-3">
        <% teams.forEach(t => { 
          const logo = t.logo_url || 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=200&auto=format&fit=crop';
          const country = t.country || 'Global';
        %>
          <div class="flex flex-col sm:flex-row sm:items-center justify-between p-3.5 rounded-xl bg-slate-900/60 border border-white/10 hover:border-orange-500/30 transition-all gap-3">
            <div class="flex items-center gap-3">
              <div class="relative group/logo shrink-0">
                <img src="<%= logo %>" alt="<%= t.name %>" class="w-12 h-12 rounded-xl object-cover bg-slate-800 border border-white/10 group-hover/logo:border-orange-500/60 transition-all" onerror="this.src='https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=200&auto=format&fit=crop'">
                <button 
                  type="button" 
                  onclick="openEditTeamModal('<%= t.id %>', '<%= t.name %>', '<%= t.tag %>', '<%= country %>', '<%= logo %>')"
                  class="absolute inset-0 bg-black/60 rounded-xl opacity-0 group-hover/logo:opacity-100 flex items-center justify-center transition-opacity text-white text-[10px] font-bold"
                  title="Click to change logo"
                >
                  <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                </button>
              </div>
              <div>
                <div class="flex items-center gap-2">
                  <span class="font-bold text-white text-base"><%= t.name %></span>
                  <span class="badge-official text-[10px]"><%= t.tag %></span>
                </div>
                <p class="text-xs text-slate-400 font-mono"><%= country %></p>
              </div>
            </div>

            <div class="flex items-center gap-2 self-end sm:self-center">
              <button 
                type="button" 
                onclick="openEditTeamModal('<%= t.id %>', '<%= t.name %>', '<%= t.tag %>', '<%= country %>', '<%= logo %>')"
                class="btn-glass text-xs py-1.5 px-3 text-orange-400 hover:text-white hover:border-orange-500/50 flex items-center gap-1.5"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                Upload Logo / Edit
              </button>
              <a href="/team/<%= t.id %>" class="btn-glass text-xs py-1.5 px-3">
                View Public
              </a>
              <form action="/admin/teams/<%= t.id %>/delete" method="POST" onsubmit="return confirm('Delete team <%= t.name %> and associated roster?');" class="inline">
                <button type="submit" class="btn-glass text-xs py-1.5 px-2.5 text-red-400 hover:bg-red-500/20" title="Delete">
                  &times;
                </button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    </div>

  </div>

  <!-- Edit Team & Upload Logo Modal -->
  <div id="editTeamModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="glass-panel max-w-lg w-full p-6 space-y-6 border border-orange-500/30 relative animate-smooth-in shadow-2xl bg-slate-950">
      
      <!-- Close Button -->
      <button type="button" onclick="closeEditTeamModal()" class="absolute top-4 right-4 text-slate-400 hover:text-white text-2xl font-bold w-8 h-8 flex items-center justify-center rounded-lg hover:bg-white/10 transition-colors">
        &times;
      </button>

      <div class="border-b border-white/10 pb-3">
        <h3 class="font-display text-2xl font-bold text-white flex items-center gap-2">
          <svg class="w-6 h-6 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Upload Logo & Edit Team
        </h3>
        <p class="text-xs text-slate-400 mt-1">Upload a new team crest logo (Sharp auto-compressed) or edit team profile.</p>
      </div>

      <form id="editTeamForm" method="POST" enctype="multipart/form-data" class="space-y-4">
        
        <!-- Logo Upload Box with Live Preview -->
        <div class="p-4 rounded-xl bg-slate-900/90 border border-orange-500/20 space-y-3">
          <label class="block text-xs font-mono text-orange-400 uppercase font-bold">Team Crest / Logo</label>
          <div class="flex items-center gap-4">
            <div class="relative shrink-0">
              <img id="editTeamLogoPreview" src="" alt="Logo Preview" class="w-20 h-20 rounded-2xl object-cover border-2 border-orange-500/50 shadow-md bg-slate-800" onerror="this.src='https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=200&auto=format&fit=crop'">
            </div>
            <div class="flex-1 space-y-2">
              <label class="btn-fire w-full cursor-pointer text-xs py-2.5 justify-center flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <span id="editTeamFileName">Upload New Logo</span>
                <input type="file" name="logo" id="editTeamFileInput" accept="image/*" class="hidden" onchange="previewImage(this, 'editTeamLogoPreview', 'editTeamFileName')">
              </label>
              <p class="text-[11px] font-mono text-slate-400">PNG, JPG, WebP. Auto-compressed with Sharp.</p>
            </div>
          </div>
          
          <div>
            <label for="edit_logo_url" class="block text-[11px] font-mono text-slate-400 mb-1">Or Direct Logo URL:</label>
            <input 
              type="text" 
              id="edit_logo_url" 
              name="logo_url" 
              placeholder="https://..." 
              class="w-full px-3 py-1.5 rounded-lg bg-black/40 border border-white/10 text-white text-xs font-mono placeholder-slate-600 focus:outline-none focus:border-orange-500"
              oninput="document.getElementById('editTeamLogoPreview').src = this.value || 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=200&auto=format&fit=crop'"
            >
          </div>
        </div>

        <div>
          <label for="edit_team_name" class="block text-xs font-mono text-slate-300 uppercase mb-1">Team Name *</label>
          <input 
            type="text" 
            id="edit_team_name" 
            name="name" 
            required 
            class="w-full px-4 py-2.5 rounded-xl bg-slate-900 border border-white/15 text-white focus:outline-none focus:border-orange-500 text-sm font-bold"
          >
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="edit_team_tag" class="block text-xs font-mono text-slate-300 uppercase mb-1">Tag (Short Code) *</label>
            <input 
              type="text" 
              id="edit_team_tag" 
              name="tag" 
              required 
              class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-white/15 text-white text-sm font-mono uppercase focus:outline-none focus:border-orange-500"
            >
          </div>
          <div>
            <label for="edit_team_country" class="block text-xs font-mono text-slate-300 uppercase mb-1">Country / Region</label>
            <input 
              type="text" 
              id="edit_team_country" 
              name="country" 
              class="w-full px-3 py-2 rounded-xl bg-slate-900 border border-white/15 text-white text-sm focus:outline-none focus:border-orange-500"
            >
          </div>
        </div>

        <div class="flex items-center gap-3 pt-2">
          <button type="button" onclick="closeEditTeamModal()" class="btn-glass flex-1 py-3 text-sm">
            Cancel
          </button>
          <button type="submit" class="btn-fire flex-1 py-3 text-sm">
            Save & Update Logo
          </button>
        </div>

      </form>
    </div>
  </div>

</main>

<script>
  function previewImage(input, previewImgId, labelTextId) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const reader = new FileReader();
      reader.onload = function(e) {
        const previewImg = document.getElementById(previewImgId);
        if (previewImg) previewImg.src = e.target.result;
      };
      reader.readAsDataURL(file);

      if (labelTextId) {
        const labelText = document.getElementById(labelTextId);
        if (labelText) labelText.textContent = file.name.length > 18 ? file.name.substring(0, 15) + '...' : file.name;
      }
    }
  }

  function openEditTeamModal(id, name, tag, country, logoUrl) {
    const modal = document.getElementById('editTeamModal');
    const form = document.getElementById('editTeamForm');
    
    form.action = `/admin/teams/${id}/edit`;
    document.getElementById('edit_team_name').value = name || '';
    document.getElementById('edit_team_tag').value = tag || '';
    document.getElementById('edit_team_country').value = country || 'Global';
    document.getElementById('edit_logo_url').value = logoUrl || '';
    document.getElementById('editTeamLogoPreview').src = logoUrl || 'https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=200&auto=format&fit=crop';
    document.getElementById('editTeamFileName').textContent = 'Upload New Logo';
    document.getElementById('editTeamFileInput').value = '';

    modal.classList.remove('hidden');
  }

  function closeEditTeamModal() {
    const modal = document.getElementById('editTeamModal');
    modal.classList.add('hidden');
  }

  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeEditTeamModal();
    }
  });

  document.getElementById('editTeamModal')?.addEventListener('click', function(e) {
    if (e.target === this) {
      closeEditTeamModal();
    }
  });
</script>

</main>

<%- include('../partials/footer') %>
