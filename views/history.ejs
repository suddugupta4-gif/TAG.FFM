<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">

  <%- include('partials/flash') %>

  <!-- History Page Header -->
  <div class="glass-panel bg-black/80 backdrop-blur-xl p-6 sm:p-8 rounded-3xl border border-white/15 shadow-2xl flex flex-col lg:flex-row lg:items-center justify-between gap-6">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="badge-official flex items-center gap-1">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          SAVED TOURNAMENTS & MATCHES 1–6
        </span>
        <% if (officialOnly) { %>
          <span class="badge-official text-[10px]">OFFICIAL ONLY</span>
        <% } else { %>
          <span class="badge-unofficial text-[10px]">ALL MATCHES (LIVE + OFFICIAL)</span>
        <% } %>
      </div>
      <h1 class="font-display text-4xl sm:text-5xl font-bold text-white tracking-wide">
        Tournament History
      </h1>
      <p class="text-slate-400 text-sm mt-1 max-w-2xl">
        Every saved tournament with all 6 matches, map locations, individual squad player kills, and match MVPs automatically archived.
      </p>
    </div>

    <!-- Quick Actions -->
    <div class="flex items-center gap-3">
      <% if (isAdmin) { %>
        <a href="<%= adminHref('/admin/tournaments') %>" class="btn-fire text-xs py-2.5 px-4 flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Manage Tournaments & Matches
        </a>
      <% } %>
      <a href="/analysis" class="btn-glass text-xs py-2.5 px-4 flex items-center gap-2">
        <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        Overall Analysis
      </a>
    </div>
  </div>

  <!-- Interactive Tournament Selector Tabs -->
  <div class="glass-panel bg-black/75 backdrop-blur-xl p-5 rounded-2xl border border-white/10 space-y-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/10 pb-3">
      <span class="text-xs font-mono text-slate-300 font-bold uppercase tracking-wider flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
        Select Tournament to View Matches (1–6) & Player Kills
      </span>
      
      <!-- Official vs All Toggle -->
      <div class="flex items-center gap-2">
        <a href="/history<%= selectedTournamentId ? '?tournament_id=' + selectedTournamentId : '' %>" 
           class="px-3 py-1 rounded-lg text-xs font-mono transition-all <%= !officialOnly ? 'bg-orange-500 text-white font-bold' : 'bg-white/5 text-slate-400 hover:text-white' %>">
          All Matches
        </a>
        <a href="/history?filter=official<%= selectedTournamentId ? '&tournament_id=' + selectedTournamentId : '' %>" 
           class="px-3 py-1 rounded-lg text-xs font-mono transition-all <%= officialOnly ? 'bg-emerald-500 text-white font-bold' : 'bg-white/5 text-slate-400 hover:text-white' %>">
          Official Only
        </a>
      </div>
    </div>

    <!-- Tournament Pills / Tabs -->
    <div class="flex flex-wrap items-center gap-2">
      <a href="/history<%= officialOnly ? '?filter=official' : '' %>" 
         class="px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all flex items-center gap-1.5 <%= !selectedTournamentId ? 'bg-gradient-to-r from-orange-500 to-amber-500 text-white shadow-lg shadow-orange-950/50' : 'bg-white/5 text-slate-300 hover:bg-white/10 border border-white/10' %>">
        <span>🏆 All Saved Tournaments</span>
        <span class="px-1.5 py-0.5 rounded bg-black/40 text-[10px]"><%= tournamentsHistory.length %></span>
      </a>

      <% tournamentsHistory.forEach(th => { 
        const isSelected = (selectedTournamentId === th.tournament.id);
      %>
        <a href="/history?tournament_id=<%= th.tournament.id %><%= officialOnly ? '&filter=official' : '' %>" 
           class="px-4 py-2 rounded-xl text-xs font-mono font-bold transition-all flex items-center gap-2 <%= isSelected ? 'bg-gradient-to-r from-orange-500 to-amber-500 text-white shadow-lg shadow-orange-950/50' : 'bg-white/5 text-slate-300 hover:bg-white/10 border border-white/10' %>">
          <span><%= th.tournament.name %></span>
          <% if (th.tournament.is_current) { %>
            <span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[10px]">Current</span>
          <% } %>
          <span class="px-1.5 py-0.5 rounded bg-black/40 text-[10px] text-amber-300"><%= th.totalMatchesCount %> M</span>
        </a>
      <% }); %>
    </div>
  </div>

  <!-- ========================================================================= -->
  <!-- TOURNAMENTS WITH MATCHES 1 TO 6 & INDIVIDUAL PLAYER STATS                 -->
  <!-- ========================================================================= -->
  <% 
    const displayedTournaments = selectedTournamentId 
      ? tournamentsHistory.filter(th => th.tournament.id === selectedTournamentId)
      : tournamentsHistory;

    if (displayedTournaments.length === 0) { 
  %>
    <div class="glass-panel bg-black/80 backdrop-blur-xl p-12 text-center space-y-4 rounded-3xl border border-white/10">
      <div class="w-14 h-14 rounded-2xl bg-orange-500/20 text-orange-400 mx-auto flex items-center justify-center border border-orange-500/30">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </div>
      <h2 class="font-display text-2xl font-bold text-white">No tournaments saved in history yet</h2>
      <p class="text-xs text-slate-400 max-w-md mx-auto">
        When tournaments and their 6 matches are logged and saved in Admin, they will automatically appear here grouped by tournament name.
      </p>
      <% if (isAdmin) { %>
        <a href="<%= adminHref('/admin/tournaments/new') %>" class="btn-fire text-xs py-2 px-4 inline-block">Create & Save Tournament</a>
      <% } %>
    </div>
  <% } else { %>

    <div class="space-y-10">
      <% displayedTournaments.forEach((th, tIdx) => { 
        const t = th.tournament;
        const matchesList = th.matches;
        const squadPlayers = th.tournamentPlayers;
        const standingsList = th.standings;
      %>
        <!-- SINGLE UNIFIED BLACK BLUR GLASS TOURNAMENT BOX -->
        <section class="glass-panel bg-black/85 backdrop-blur-2xl p-6 sm:p-8 md:p-10 rounded-3xl border border-white/15 shadow-2xl space-y-8 relative overflow-hidden transition-all duration-300">
          
          <!-- Banner Backdrop Overlay -->
          <% if (t.banner_url) { %>
            <div class="absolute inset-0 z-0 opacity-20 bg-cover bg-center" style="background-image: url('<%= t.banner_url %>'); filter: blur(2px);"></div>
            <div class="absolute inset-0 bg-gradient-to-b from-[#050508]/80 via-[#050508]/95 to-[#050508] z-0"></div>
          <% } %>

          <div class="relative z-10 space-y-6">
            
            <!-- Tournament Card Header -->
            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 border-b border-white/10 pb-6">
              <div class="space-y-2">
                <div class="flex flex-wrap items-center gap-2">
                  <% if (t.is_current) { %>
                    <span class="badge-live">
                      <span class="live-dot"></span>
                      CURRENT TOURNAMENT
                    </span>
                  <% } else { %>
                    <span class="badge-official">ARCHIVED TOURNAMENT</span>
                  <% } %>
                  <span class="px-2.5 py-0.5 rounded-md text-xs font-mono bg-white/10 text-gray-200 border border-white/15">
                    <%= t.game_mode || 'Battle Royale Squad' %>
                  </span>
                  <span class="px-2.5 py-0.5 rounded-md text-xs font-mono bg-orange-500/20 text-orange-300 border border-orange-500/30 font-bold">
                    <%= matchesList.length %> Matches Logged (1–6)
                  </span>
                </div>

                <h2 class="font-display text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-wide">
                  <%= t.name %>
                </h2>
                <p class="text-slate-300 text-sm max-w-3xl leading-relaxed">
                  <%= t.description || 'Premier Free Fire MAX tournament ledger. All match maps, scores, and player frags recorded.' %>
                </p>
              </div>

              <!-- Quick Tournament Metrics Summary Pills -->
              <div class="flex flex-wrap items-center gap-3">
                <% if (th.champion) { %>
                  <div class="p-3 rounded-2xl bg-amber-500/10 border border-amber-500/25 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/20 flex items-center justify-center text-amber-400 font-bold text-lg">
                      👑
                    </div>
                    <div>
                      <span class="text-[10px] font-mono text-amber-400/80 uppercase font-bold block">Tournament Leader</span>
                      <span class="font-bold text-sm text-white"><%= th.champion.team_name %></span>
                      <span class="text-xs font-mono text-amber-400 block"><%= th.champion.total_points %> PTS (<%= th.champion.booyahs %> Booyah)</span>
                    </div>
                  </div>
                <% } %>

                <% if (th.tagStanding) { %>
                  <div class="p-3 rounded-2xl bg-orange-500/10 border border-orange-500/25 flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-orange-500/20 flex items-center justify-center text-orange-400 font-bold font-mono text-sm">
                      TAG
                    </div>
                    <div>
                      <span class="text-[10px] font-mono text-orange-400/80 uppercase font-bold block">TAG Squad</span>
                      <span class="font-bold text-sm text-white">#<%= th.tagStanding.rank || 1 %> Standing</span>
                      <span class="text-xs font-mono text-orange-400 block"><%= th.tagStanding.total_points %> PTS (<%= th.tagStanding.total_kills || 0 %> Kills)</span>
                    </div>
                  </div>
                <% } %>
              </div>
            </div>

            <!-- ========================================================================= -->
            <!-- 1. MATCHES 1 TO 6 LEDGER CARDS WITH MAPS & PLAYER STATS                   -->
            <!-- ========================================================================= -->
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="w-2.5 h-2.5 rounded-full bg-[#ff4e00]"></span>
                  <h3 class="font-display text-2xl font-bold text-white tracking-wide">
                    Matches 1–6 Ledger & Map Telemetry
                  </h3>
                </div>
                <span class="text-xs font-mono text-slate-400">
                  Total <%= matchesList.length %> / 6 Matches Played
                </span>
              </div>

              <% if (matchesList.length === 0) { %>
                <div class="p-6 rounded-2xl bg-black/40 border border-white/5 text-center text-slate-400 font-mono text-xs">
                  No matches logged yet for <%= t.name %>. Use the Admin logger to add Matches 1 through 6.
                </div>
              <% } else { %>
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">
                  <% matchesList.forEach((m) => { %>
                    <div class="glass-card bg-black/60 backdrop-blur-md p-5 rounded-2xl border border-white/10 hover:border-orange-500/40 transition-all space-y-4">
                      
                      <!-- Match Header -->
                      <div class="flex items-center justify-between border-b border-white/10 pb-3">
                        <div class="flex items-center gap-3">
                          <span class="font-display text-xl sm:text-2xl font-bold text-white">
                            MATCH #<%= m.match_number %>
                          </span>
                          <span class="px-2.5 py-1 rounded-lg bg-orange-500/15 border border-orange-500/30 font-mono text-xs text-orange-300 font-bold flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
                            Map: <%= m.map_name %>
                          </span>
                        </div>

                        <div>
                          <% if (m.is_official) { %>
                            <span class="badge-official text-[10px]">OFFICIAL</span>
                          <% } else { %>
                            <span class="badge-unofficial text-[10px]">LOCAL</span>
                          <% } %>
                        </div>
                      </div>

                      <!-- Match Key Telemetry (Position 1-12, Total Kills, Total Points of Match) -->
                      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 text-xs font-mono">
                        
                        <!-- 1. POSITION 1-12 -->
                        <div class="p-2.5 rounded-xl bg-amber-500/10 border border-amber-500/20 flex flex-col justify-between">
                          <span class="text-[9px] text-amber-400 uppercase font-bold block">📍 POSITION (1-12)</span>
                          <span class="font-bold text-white text-xs sm:text-sm">
                            #<%= m.tagResult ? m.tagResult.placement : 1 %> Place
                          </span>
                          <span class="text-[10px] text-amber-400 font-bold">
                            <%
                              let placePtsVal = 0;
                              if (m.tagResult) {
                                if (m.tagResult.placement_points !== undefined && m.tagResult.placement_points !== null) {
                                  placePtsVal = Number(m.tagResult.placement_points);
                                } else {
                                  const p = Number(m.tagResult.placement);
                                  placePtsVal = p === 1 ? 12 : (p === 2 ? 9 : (p === 3 ? 8 : (p === 4 ? 7 : (p === 5 ? 6 : (p === 6 ? 5 : (p === 7 ? 4 : (p === 8 ? 3 : (p === 9 ? 2 : (p === 10 ? 1 : 0)))))))));
                                }
                              } else {
                                placePtsVal = 12;
                              }
                            %>
                            <%= placePtsVal %> Placement PTS
                          </span>
                        </div>

                        <!-- 2. TOTAL KILLS -->
                        <div class="p-2.5 rounded-xl bg-orange-500/10 border border-orange-500/20 flex flex-col justify-between">
                          <span class="text-[9px] text-orange-400 uppercase font-bold block">💥 TOTAL KILLS</span>
                          <span class="font-bold text-white text-xs sm:text-sm">
                            <%= m.tagResult ? (m.tagResult.kills || 0) : (uniqueHistSquadStats ? uniqueHistSquadStats.reduce((acc, ps) => acc + Number(ps.kills || 0), 0) : 0) %> Kills
                          </span>
                          <span class="text-[10px] text-orange-400 font-bold">
                            <%= m.tagResult ? (m.tagResult.kills || 0) + ' Kill PTS' : '0 Kill PTS' %>
                          </span>
                        </div>

                        <!-- 3. TOTAL POINTS OF MATCH -->
                        <div class="p-2.5 rounded-xl bg-red-500/10 border border-red-500/20 flex flex-col justify-between">
                          <span class="text-[9px] text-red-400 uppercase font-bold block">🏆 TOTAL POINTS</span>
                          <span class="font-bold text-white text-xs sm:text-sm">
                            <%= m.tagResult ? (m.tagResult.total_points || 0) : 0 %> PTS
                          </span>
                          <span class="text-[10px] text-red-400 font-bold">
                            <%= m.tagResult ? (m.tagResult.placement_points || 0) : 0 %> Place + <%= m.tagResult ? (m.tagResult.kills || 0) : 0 %> Kill PTS
                          </span>
                        </div>

                      </div>

                      <!-- Individual Squad Player Kills Pills (Match Telemetry) -->
                      <% 
                        const uniqueHistSquadStats = [];
                        const seenHistPMap = new Set();
                        if (m.player_stats && Array.isArray(m.player_stats)) {
                          m.player_stats.forEach(ps => {
                            const pid = ps.player_id || ps.id || ps.in_game_name;
                            if (!seenHistPMap.has(pid)) {
                              seenHistPMap.add(pid);
                              uniqueHistSquadStats.push(ps);
                            }
                          });
                        }
                      %>
                      <% if (uniqueHistSquadStats.length > 0) { %>
                        <div class="p-3 rounded-xl bg-black/50 border border-white/5 space-y-2">
                          <div class="flex items-center justify-between text-[11px] font-mono">
                            <span class="text-slate-400 font-bold uppercase flex items-center gap-1.5">
                              <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
                              Squad Player Kills (Match #<%= m.match_number %>)
                            </span>
                            <span class="text-orange-400 font-bold">
                              Sum: <%= uniqueHistSquadStats.reduce((acc, ps) => acc + Number(ps.kills || 0), 0) %> Kills
                            </span>
                          </div>

                          <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
                            <% uniqueHistSquadStats.forEach((ps) => { %>
                              <div class="p-1.5 rounded-lg bg-white/5 border border-white/5 flex items-center justify-between text-[11px] font-mono">
                                <span class="text-white font-bold truncate pr-1"><%= ps.in_game_name || ps.player_name %></span>
                                <span class="text-orange-400 font-bold shrink-0"><%= ps.kills || 0 %>K</span>
                              </div>
                            <% }); %>
                          </div>
                        </div>
                      <% } %>

                      <!-- 12-Squad Standings Dropdown Toggle -->
                      <% if (m.results && m.results.length > 0) { %>
                        <details class="group">
                          <summary class="cursor-pointer text-xs font-mono text-slate-400 hover:text-orange-400 flex items-center gap-1.5 select-none pt-1">
                            <svg class="w-3.5 h-3.5 text-orange-400 group-open:rotate-90 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                            <span>View 12-Squad Match Scoreboard</span>
                          </summary>

                          <div class="mt-2.5 overflow-x-auto rounded-xl border border-white/5 bg-black/40">
                            <table class="w-full text-left text-[11px] font-mono">
                              <thead>
                                <tr class="bg-white/5 text-slate-400 border-b border-white/5">
                                  <th class="py-1.5 px-2.5">#</th>
                                  <th class="py-1.5 px-2.5">Team</th>
                                  <th class="py-1.5 px-2 text-center">Kills</th>
                                  <th class="py-1.5 px-2 text-center">Place PTS</th>
                                  <th class="py-1.5 px-2.5 text-right">Total PTS</th>
                                </tr>
                              </thead>
                              <tbody class="divide-y divide-white/5">
                                <% m.results.forEach(res => { 
                                  const isTag = (res.team_tag === 'TAG' || (res.team_name || '').includes('TAG'));
                                %>
                                  <tr class="<%= res.placement === 1 ? 'bg-amber-500/10 text-amber-300 font-bold' : (isTag ? 'bg-orange-500/10 text-orange-300 font-bold' : 'text-slate-300 hover:bg-white/5') %>">
                                    <td class="py-1.5 px-2.5"><%= res.placement === 1 ? '👑 #1' : '#' + res.placement %></td>
                                    <td class="py-1.5 px-2.5 font-bold truncate max-w-[120px]"><%= res.team_name %></td>
                                    <td class="py-1.5 px-2 text-center text-red-400"><%= res.kills %></td>
                                    <td class="py-1.5 px-2 text-center text-slate-400"><%= res.placement_points %></td>
                                    <td class="py-1.5 px-2.5 text-right font-bold text-white"><%= res.total_points %></td>
                                  </tr>
                                <% }); %>
                              </tbody>
                            </table>
                          </div>
                        </details>
                      <% } %>

                    </div>
                  <% }); %>
                </div>
              <% } %>
            </div>

            <!-- ========================================================================= -->
            <!-- 2. SQUAD CUMULATIVE PLAYER KILLS IN THIS TOURNAMENT                       -->
            <!-- ========================================================================= -->
            <% if (squadPlayers && squadPlayers.length > 0) { %>
              <div class="space-y-3 pt-4 border-t border-white/10">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-amber-400"></span>
                    <h3 class="font-display text-xl sm:text-2xl font-bold text-white tracking-wide">
                      <%= t.name %> — Squad Player Kills & Frags
                    </h3>
                  </div>
                  <span class="text-xs font-mono text-amber-400 font-bold">
                    Cumulative Tournament Stats
                  </span>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-white/10 bg-black/50">
                  <table class="w-full text-left text-xs font-mono">
                    <thead>
                      <tr class="bg-white/5 border-b border-white/10 text-slate-400 text-[11px] uppercase">
                        <th class="py-2.5 px-4 text-center w-12">#</th>
                        <th class="py-2.5 px-4">Squad Player</th>
                        <th class="py-2.5 px-3">Role</th>
                        <th class="py-2.5 px-3 text-center">Matches</th>
                        <th class="py-2.5 px-3 text-center text-orange-400 font-bold">Total Kills</th>
                        <th class="py-2.5 px-3 text-center text-amber-400">Avg Kills</th>
                        <th class="py-2.5 px-4 text-right">Total Damage</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                      <% squadPlayers.forEach((sp, spIdx) => { %>
                        <tr class="hover:bg-white/5 transition-colors">
                          <td class="py-3 px-4 text-center font-display text-sm font-bold <%= spIdx === 0 ? 'text-amber-400' : 'text-slate-400' %>">
                            #<%= spIdx + 1 %>
                          </td>
                          <td class="py-3 px-4">
                            <div class="flex items-center gap-2.5">
                              <% if (sp.avatar_url) { %>
                                <img src="<%= sp.avatar_url %>" alt="" class="w-7 h-7 rounded-lg object-cover border border-white/10">
                              <% } %>
                              <div>
                                <a href="/player/<%= sp.player_id %>" class="font-bold text-white hover:text-orange-400 transition-colors">
                                  <%= sp.in_game_name || sp.player_name %>
                                </a>
                                <% if (spIdx === 0 && sp.total_kills > 0) { %>
                                  <span class="ml-1 px-1.5 py-0.5 rounded bg-amber-500/20 text-amber-300 text-[9px] font-bold">MVP</span>
                                <% } %>
                              </div>
                            </div>
                          </td>
                          <td class="py-3 px-3 text-slate-300"><%= sp.role || 'Rusher' %></td>
                          <td class="py-3 px-3 text-center text-slate-300"><%= sp.matches_count %></td>
                          <td class="py-3 px-3 text-center font-display text-base font-bold text-orange-400"><%= sp.total_kills %></td>
                          <td class="py-3 px-3 text-center text-amber-400 font-bold"><%= sp.avg_kills %></td>
                          <td class="py-3 px-4 text-right text-slate-300 font-bold"><%= sp.total_damage.toLocaleString() %></td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            <% } %>

            <!-- ========================================================================= -->
            <!-- 3. TOURNAMENT STANDINGS SCOREBOARD (12 TEAMS)                             -->
            <!-- ========================================================================= -->
            <% if (standingsList && standingsList.length > 0) { %>
              <div class="space-y-3 pt-4 border-t border-white/10">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                    <h3 class="font-display text-xl sm:text-2xl font-bold text-white tracking-wide">
                      <%= t.name %> — Tournament Standings
                    </h3>
                  </div>
                  <span class="text-xs font-mono text-emerald-400 font-bold">
                    Official 12-Squad Standings
                  </span>
                </div>

                <div class="overflow-x-auto rounded-2xl border border-white/10 bg-black/50">
                  <table class="w-full text-left text-xs font-mono">
                    <thead>
                      <tr class="bg-white/5 border-b border-white/10 text-slate-400 text-[11px] uppercase">
                        <th class="py-2.5 px-3 text-center w-10">#</th>
                        <th class="py-2.5 px-3 min-w-[130px]">Team</th>
                        <th class="py-2.5 px-2 text-center text-orange-400 font-bold">M1</th>
                        <th class="py-2.5 px-2 text-center text-orange-400 font-bold">M2</th>
                        <th class="py-2.5 px-2 text-center text-orange-400 font-bold">M3</th>
                        <th class="py-2.5 px-2 text-center text-orange-400 font-bold">M4</th>
                        <th class="py-2.5 px-2 text-center text-orange-400 font-bold">M5</th>
                        <th class="py-2.5 px-2 text-center text-orange-400 font-bold">M6</th>
                        <th class="py-2.5 px-2 text-center text-amber-400 font-bold">👑 Booyah</th>
                        <th class="py-2.5 px-2 text-center text-red-400 font-bold">Kills</th>
                        <th class="py-2.5 px-4 text-right text-orange-400 font-bold bg-orange-500/10 border-l border-orange-500/20">TOTAL PTS</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-white/5">
                      <% standingsList.forEach((st, sIdx) => { 
                        const isTag = (st.team_tag === 'TAG' || (st.team_name || '').includes('TAG'));
                      %>
                        <tr class="hover:bg-white/5 transition-colors <%= isTag ? 'bg-orange-500/10 border-l-2 border-orange-500 font-bold' : '' %>">
                          <td class="py-2.5 px-3 text-center font-display text-sm font-bold <%= sIdx === 0 ? 'text-amber-400' : 'text-slate-400' %>">
                            #<%= sIdx + 1 %>
                          </td>
                          <td class="py-2.5 px-3">
                            <div class="flex items-center gap-2">
                              <% if (st.team_logo) { %>
                                <img src="<%= st.team_logo %>" alt="" class="w-5 h-5 rounded-full object-cover">
                              <% } %>
                              <span class="font-bold <%= isTag ? 'text-orange-400' : 'text-white' %>"><%= st.team_name %></span>
                              <span class="text-[10px] text-slate-500">[<%= st.team_tag %>]</span>
                            </div>
                          </td>

                          <!-- Match 1 to 6 Individual Match Points Breakdown -->
                          <% for (let m = 1; m <= 6; m++) { 
                              const mScore = (st.match_scores && st.match_scores[m]) ? st.match_scores[m] : null;
                          %>
                            <td class="py-2.5 px-2 text-center font-mono">
                              <% if (mScore) { %>
                                <div class="flex flex-col items-center">
                                  <span class="font-bold text-white text-xs <%= mScore.placement === 1 ? 'text-amber-400 font-display' : '' %>">
                                    <%= mScore.total_points %>
                                  </span>
                                  <span class="text-[9px] text-slate-400 font-normal">
                                    #<%= mScore.placement %> | <%= mScore.kills %>K
                                  </span>
                                </div>
                              <% } else { %>
                                <span class="text-slate-600 text-xs">-</span>
                              <% } %>
                            </td>
                          <% } %>

                          <td class="py-2.5 px-2 text-center text-amber-400 font-bold"><%= st.booyahs %></td>
                          <td class="py-2.5 px-2 text-center text-red-400 font-bold"><%= st.total_kills || st.kill_points %></td>
                          <td class="py-2.5 px-4 text-right font-display text-sm font-bold <%= isTag ? 'text-orange-400' : 'text-white' %> bg-orange-500/5 border-l border-orange-500/20">
                            <%= st.total_points %> <span class="text-[10px] font-normal text-slate-500">PTS</span>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              </div>
            <% } %>

          </div>
        </section>
      <% }); %>
    </div>

  <% } %>

  <!-- ========================================================================= -->
  <!-- 5-MAP PERFORMANCE INTELLIGENCE ARCHIVE                                    -->
  <!-- ========================================================================= -->
  <% if (mapAnalysis && mapAnalysis.maps) { %>
    <section class="glass-panel bg-black/80 backdrop-blur-xl p-6 sm:p-8 rounded-3xl border border-white/10 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <div class="flex items-center gap-2">
            <span class="badge-official">MAP INTELLIGENCE</span>
            <span class="text-xs font-mono text-orange-400">5 OFFICIAL MAPS</span>
          </div>
          <h2 class="font-display text-2xl font-bold text-white tracking-wide">Map Performance Analysis</h2>
          <p class="text-slate-400 text-xs mt-0.5">Win rates, kills, and team records on Bermuda, Purgatory, Kalahari, Solara, and Nexterra.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
        <% mapAnalysis.maps.forEach(mapItem => { %>
          <div class="glass-card bg-black/60 p-4 rounded-2xl border border-white/10 space-y-3 relative overflow-hidden group hover:border-orange-500/40 transition-all">
            <div class="flex items-center justify-between">
              <span class="font-display text-lg font-bold text-white group-hover:text-orange-400 transition-colors"><%= mapItem.map_name %></span>
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-white/5 text-slate-300">
                <%= mapItem.matches_played %> Matches
              </span>
            </div>

            <div class="grid grid-cols-2 gap-2 text-xs font-mono">
              <div class="p-2 rounded-lg bg-black/40">
                <span class="text-[10px] text-slate-500 block">Win Rate</span>
                <span class="font-bold text-amber-400"><%= mapItem.tag_win_rate %>%</span>
              </div>
              <div class="p-2 rounded-lg bg-black/40">
                <span class="text-[10px] text-slate-500 block">Booyahs</span>
                <span class="font-bold text-emerald-400"><%= mapItem.tag_booyahs %></span>
              </div>
              <div class="p-2 rounded-lg bg-black/40">
                <span class="text-[10px] text-slate-500 block">TAG Kills</span>
                <span class="font-bold text-orange-400"><%= mapItem.tag_kills %></span>
              </div>
              <div class="p-2 rounded-lg bg-black/40">
                <span class="text-[10px] text-slate-500 block">Avg Kills</span>
                <span class="font-bold text-slate-200"><%= mapItem.tag_avg_kills %></span>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>

</main>

<%- include('partials/footer') %>
