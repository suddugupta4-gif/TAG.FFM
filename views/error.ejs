<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-4xl mx-auto px-4 py-16 text-center">
  <div class="glass-panel p-10 max-w-lg mx-auto">
    <div class="w-16 h-16 rounded-2xl bg-red-500/20 border border-red-500/30 text-red-400 mx-auto flex items-center justify-center mb-6">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
      </svg>
    </div>
    
    <h1 class="font-display text-4xl font-bold text-white mb-2">Error Encountered</h1>
    <p class="text-slate-400 mb-8"><%= typeof message !== 'undefined' ? message : 'An unexpected error occurred while loading esports data.' %></p>
    
    <div class="flex justify-center gap-4">
      <a href="/" class="btn-fire">Back to Homepage</a>
      <a href="javascript:history.back()" class="btn-glass">Go Back</a>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
