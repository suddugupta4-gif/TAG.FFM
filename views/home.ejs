<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-8">

  <%- include('partials/flash') %>

  <!-- ========================================================================= -->
  <!-- 1. TOP OF EVERYTHING: GLOBAL OFFICIAL / UNOFFICIAL MODE SELECTOR           -->
  <!-- ========================================================================= -->
  <section class="w-full relative z-20" id="global-mode-selector-section">
    <div class="glass-panel p-3.5 sm:p-4 border-white/15 bg-[#0a0c14]/90 backdrop-blur-2xl shadow-2xl rounded-2xl">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
        <!-- Label & Context -->
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#ff4e00]/20 to-amber-500/10 border border-[#ff4e00]/30 flex items-center justify-center text-[#ff4e00] shadow-lg shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs font-mono font-bold text-gray-400 uppercase tracking-wider">GLOBAL DATA FILTER</span>
              <span id="active-mode-indicator" class="badge-official text-[10px] py-0.5">OFFICIAL MODE</span>
            </div>
            <h2 class="text-sm sm:text-base font-bold text-white tracking-tight">Select Tournament Type to Filter All Data</h2>
          </div>
        </div>

        <!-- 3-Way Smooth Touch Mode Selector Buttons -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 p-1.5 rounded-xl bg-black/60 border border-white/10" id="mode-switcher-container">
          
          <!-- 1. OFFICIAL TOURNAMENT -->
          <button 
            type="button"
            id="btn-mode-official" 
            data-mode="official"
            class="global-mode-btn touch-manipulation select-none py-2 px-3.5 rounded-lg font-mono text-xs font-bold flex items-center justify-center sm:justify-start gap-2 transition-all duration-300 cursor-pointer active:scale-95 bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shadow-lg shadow-emerald-950/40">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 shadow-sm shadow-emerald-400 shrink-0"></span>
            <div class="text-left leading-tight">
              <div class="font-bold flex items-center gap-1">
                <span>Official</span>
                <span class="text-[10px] opacity-75 font-normal hidden sm:inline">(Esports)</span>
              </div>
              <div class="text-[9px] text-emerald-400/80 font-normal font-sans hidden lg:block">Official Garena / FFWS</div>
            </div>
          </button>

          <!-- 2. UNOFFICIAL (LOCAL TOURNAMENT ORGANIZER) -->
          <button 
            type="button"
            id="btn-mode-unofficial" 
            data-mode="unofficial"
            class="global-mode-btn touch-manipulation select-none py-2 px-3.5 rounded-lg font-mono text-xs font-bold flex items-center justify-center sm:justify-start gap-2 transition-all duration-300 cursor-pointer active:scale-95 bg-black/30 text-gray-400 hover:text-amber-300 hover:bg-amber-500/10 border border-transparent">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400/50 shrink-0"></span>
            <div class="text-left leading-tight">
              <div class="font-bold flex items-center gap-1">
                <span>Unofficial</span>
                <span class="text-[10px] opacity-75 font-normal hidden sm:inline">(Local)</span>
              </div>
              <div class="text-[9px] text-gray-500 font-normal font-sans hidden lg:block">Local Organizer / Scrims</div>
            </div>
          </button>

          <!-- 3. ALL / COMBINED -->
          <button 
            type="button"
            id="btn-mode-all" 
            data-mode="all"
            class="global-mode-btn touch-manipulation select-none py-2 px-3.5 rounded-lg font-mono text-xs font-bold flex items-center justify-center sm:justify-start gap-2 transition-all duration-300 cursor-pointer active:scale-95 bg-black/30 text-gray-400 hover:text-[#ff4e00] hover:bg-[#ff4e00]/10 border border-transparent">
            <span class="w-2.5 h-2.5 rounded-full bg-[#ff4e00]/50 shrink-0"></span>
            <div class="text-left leading-tight">
              <div class="font-bold flex items-center gap-1">
                <span>All Data</span>
                <span class="text-[10px] opacity-75 font-normal hidden sm:inline">(Combined)</span>
              </div>
              <div class="text-[9px] text-gray-500 font-normal font-sans hidden lg:block">Overall Add-Up Total</div>
            </div>
          </button>

        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. OVERALL ANALYSIS BOX (DIRECTLY AFTER OFFICIAL / UNOFFICIAL SELECTION)   -->
  <!-- ========================================================================= -->
  <section class="glass-panel p-5 sm:p-7 border-white/15 bg-gradient-to-b from-[#0e101a] to-[#08090f] shadow-2xl rounded-2xl space-y-5" id="overall-analysis-section">
    
    <!-- Analysis Box Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/10 pb-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-orange-500/20 border border-orange-500/30 flex items-center justify-center text-orange-400 shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
        </div>
        <div>
          <span class="text-xs font-mono text-gray-400 uppercase tracking-wider block">TAG SQUAD SQUAD CAREER & TOURNAMENT ANALYSIS</span>
          <h2 class="text-lg sm:text-xl font-display font-bold text-white tracking-wide" id="stat-card-title">
            Official Tournament Stats & Performance
          </h2>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-[#ff4e00]/20 text-[#ff4e00] border border-[#ff4e00]/30 animate-pulse">
          <span class="w-1.5 h-1.5 rounded-full bg-[#ff4e00] mr-1.5"></span>
          LIVE ADD-UP
        </span>
        <a href="/analysis#map-analysis" class="btn-glass text-xs py-1.5 px-3 flex items-center gap-1.5 text-emerald-400 border-emerald-500/30 hover:bg-emerald-500/10">
          <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
          </svg>
          <span>Map Analysis</span>
        </a>
        <a href="/analysis" class="btn-glass text-xs py-1.5 px-3 flex items-center gap-1.5">
          <span>In-Depth Analysis</span>
          <svg class="w-3.5 h-3.5 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- 4 Core Required Metrics Grid (TOTAL MATCHES, TOTAL KILLS, TOTAL BOOYAH, TOTAL KD) -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4" id="home-four-metrics-grid">
      
      <!-- 1. TOTAL MATCHES -->
      <div class="stat-box p-4 rounded-xl bg-black/40 border border-white/10 hover:border-emerald-400/40 transition-all duration-300 flex flex-col justify-between">
        <div class="text-xs text-gray-400 font-mono flex items-center justify-between mb-1">
          <span>TOTAL MATCHES</span>
          <span class="w-2 h-2 rounded-full bg-emerald-400/70"></span>
        </div>
        <div class="stat-box-value text-3xl sm:text-4xl font-display font-bold text-white flex items-baseline gap-1 my-1">
          <span id="hero-stat-matches" class="transition-all duration-300">
            <%= currentTourneySummary ? currentTourneySummary.official.matches : officialMatches.length %>
          </span>
          <span class="text-xs text-gray-500 font-mono font-normal">MATCHES</span>
        </div>
        <div id="hero-stat-matches-sub" class="text-xs text-emerald-400 font-mono transition-all">
          Official Tournament Circuit
        </div>
      </div>

      <!-- 2. TOTAL KILLS -->
      <div class="stat-box p-4 rounded-xl bg-black/40 border border-white/10 hover:border-[#ff4e00]/40 transition-all duration-300 flex flex-col justify-between">
        <div class="text-xs text-gray-400 font-mono flex items-center justify-between mb-1">
          <span>TOTAL KILLS</span>
          <span class="w-2 h-2 rounded-full bg-[#ff4e00]"></span>
        </div>
        <div class="stat-box-value text-3xl sm:text-4xl font-display font-bold text-[#ff4e00] my-1">
          <span id="hero-stat-kills" class="transition-all duration-300">
            <%= currentTourneySummary ? currentTourneySummary.official.kills : 0 %>
          </span>
        </div>
        <div id="hero-stat-kills-sub" class="text-xs text-gray-400 font-mono transition-all">
          <%= currentTourneySummary ? currentTourneySummary.official.avg_kills : '0.0' %> kills/match avg
        </div>
      </div>

      <!-- 3. TOTAL BOOYAH -->
      <div class="stat-box p-4 rounded-xl bg-black/40 border border-white/10 hover:border-amber-400/40 transition-all duration-300 flex flex-col justify-between">
        <div class="text-xs text-gray-400 font-mono flex items-center justify-between mb-1">
          <span>TOTAL BOOYAH</span>
          <svg class="w-3.5 h-3.5 text-amber-400" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
        </div>
        <div class="stat-box-value text-3xl sm:text-4xl font-display font-bold text-amber-400 my-1 flex items-center gap-1.5">
          <span id="hero-stat-booyahs" class="transition-all duration-300">
            <%= currentTourneySummary ? currentTourneySummary.official.booyahs : 0 %>
          </span>
          <span class="text-xs text-amber-400/70 font-mono font-normal">VICTORIES</span>
        </div>
        <div id="hero-stat-booyahs-sub" class="text-xs text-amber-400/80 font-mono transition-all">
          <%= currentTourneySummary ? currentTourneySummary.official.win_rate : '0.0' %>% Win Rate
        </div>
      </div>

      <!-- 4. TOTAL KD -->
      <div class="stat-box p-4 rounded-xl bg-black/40 border border-white/10 hover:border-emerald-400/40 transition-all duration-300 flex flex-col justify-between">
        <div class="text-xs text-gray-400 font-mono flex items-center justify-between mb-1">
          <span>TOTAL KD</span>
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
        </div>
        <div class="stat-box-value text-3xl sm:text-4xl font-display font-bold text-emerald-400 my-1">
          <span id="hero-stat-kd" class="transition-all duration-300">
            <%= currentTourneySummary ? currentTourneySummary.official.kd : '0.00' %>
          </span>
        </div>
        <div id="hero-stat-kd-sub" class="text-xs text-emerald-400/80 font-mono transition-all">
          Kills per Elimination
        </div>
      </div>

    </div>

    <!-- Secondary Overall Performance Indicators & Context -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-2">
      <!-- Total Points -->
      <div class="p-3 rounded-xl bg-black/30 border border-white/5 flex items-center justify-between">
        <span class="text-xs text-gray-400 font-mono">Total Points Scored</span>
        <span id="hero-stat-points" class="font-bold text-white font-mono text-sm">
          <%= currentTourneySummary ? currentTourneySummary.official.points : 0 %> PTS
        </span>
      </div>

      <!-- Tournaments Participated -->
      <div class="p-3 rounded-xl bg-black/30 border border-white/5 flex items-center justify-between">
        <span class="text-xs text-gray-400 font-mono">Career Tournaments</span>
        <span class="font-bold text-orange-400 font-mono text-sm">
          <%= careerSummary ? careerSummary.official.tournaments_played : allTournaments.length %> Tournaments
        </span>
      </div>

      <!-- Squad Status -->
      <div class="p-3 rounded-xl bg-black/30 border border-white/5 flex items-center justify-between">
        <span class="text-xs text-gray-400 font-mono">Squad Status</span>
        <span class="font-bold text-emerald-400 font-mono text-xs flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
          Active Esports Roster
        </span>
      </div>
    </div>

    <!-- Mode Context Alert Banner -->
    <div id="hero-context-box" class="p-3 rounded-xl bg-emerald-500/10 border border-emerald-500/25 text-emerald-300 text-xs flex items-start gap-2.5 transition-all">
      <svg class="w-4 h-4 shrink-0 mt-0.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <span id="hero-context-text">
        Showing verified official tournament data. All kills, Booyahs, matches, and K/D are verified esports records.
      </span>
    </div>

  </section>

  <!-- ========================================================================= -->
  <!-- 3. BANNER AND TITLE BOX WITH MAP AND DETAILS OF MATCH                     -->
  <!-- ========================================================================= -->
  <% if (currentTournament) { %>
    <section class="relative glass-panel overflow-hidden p-6 sm:p-8 md:p-10 border-white/15 shadow-2xl rounded-2xl transition-all duration-500 space-y-6" id="tournament-banner-title-box">
      
      <!-- Dynamic Banner Poster Backdrop -->
      <div id="hero-banner-bg" class="absolute inset-0 z-0 opacity-30 bg-cover bg-center transition-all duration-500" style="background-image: url('<%= currentTournament.banner_url %>'); filter: blur(1px);"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-[#050508] via-[#050508]/90 to-[#050508]/40 z-0"></div>

      <div class="relative z-10 space-y-6">
        
        <!-- Header Tags & Prize Pool & Admin Controls -->
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex flex-wrap items-center gap-2.5">
            <span id="hero-status-badge" class="badge-live">
              <span class="live-dot"></span>
              CURRENT TOURNAMENT
            </span>
            <span id="hero-type-badge" class="badge-official">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              OFFICIAL CIRCUIT
            </span>
            <span class="px-2.5 py-0.5 rounded-md text-xs font-mono bg-white/10 text-gray-200 border border-white/15">
              <%= currentTournament.game_mode %>
            </span>
          </div>

          <% if (isAdmin) { %>
            <div class="flex items-center gap-2">
              <a href="<%= adminHref('/admin/tournaments/' + currentTournament.id + '/edit') %>" class="btn-fire text-xs py-1.5 px-3.5 flex items-center gap-1.5 font-bold shadow-lg shadow-orange-950/40">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                <span>Manage Tournament & Matches</span>
              </a>
              <a href="<%= adminHref('/admin/tournaments/new') %>" class="btn-glass text-xs py-1.5 px-3 text-orange-400 font-bold">
                <span>+ New</span>
              </a>
            </div>
          <% } %>
        </div>

        <!-- Tournament Main Title & Description -->
        <div class="space-y-3">
          <h1 id="hero-tournament-title" class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-tight">
            <%= currentTournament.name %>
          </h1>

          <p id="hero-tournament-desc" class="text-gray-300 text-sm sm:text-base max-w-3xl leading-relaxed">
            <%= currentTournament.description || 'Premier Free Fire MAX championship tournament featuring TAGFREEFIREMAX contending for the global title.' %>
          </p>
        </div>

        <!-- ========================================================================= -->
        <!-- MATCH STANDINGS BOX (MOVED HERE IN PLACE OF FORMAT BOX)                   -->
        <!-- ========================================================================= -->
        <div class="p-4 sm:p-6 rounded-2xl bg-black/70 border border-white/15 backdrop-blur-xl shadow-2xl space-y-4" id="home-standings-box">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/10 pb-3">
            <div class="flex items-center gap-2.5">
              <div class="w-3 h-3 rounded-full bg-gradient-to-r from-[#ff4e00] to-amber-500 animate-pulse"></div>
              <h3 class="font-display text-lg sm:text-xl font-bold text-white tracking-wide">
                Tournament Match Standings
              </h3>
              <span id="standings-mode-tag" class="badge-official text-[10px] py-0.5">OFFICIAL</span>
            </div>
            
            <div class="flex items-center gap-3 text-xs font-mono">
              <span class="text-slate-400">
                Matches Logged: <strong id="standings-matches-count" class="text-white"><%= matches.length %></strong>
              </span>
              <a href="/tournament/<%= currentTournament.id %>" class="text-orange-400 hover:text-orange-300 flex items-center gap-1 font-bold">
                <span>Detailed Hub</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
              </a>
            </div>
          </div>

          <!-- Standings Table / List -->
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs font-mono">
              <thead>
                <tr class="text-slate-400 uppercase border-b border-white/10 text-[11px]">
                  <th class="py-2.5 px-3">#</th>
                  <th class="py-2.5 px-3">Team</th>
                  <th class="py-2.5 px-2 text-center">Matches</th>
                  <th class="py-2.5 px-2 text-center">Booyah</th>
                  <th class="py-2.5 px-2 text-center">Kills</th>
                  <th class="py-2.5 px-2 text-center hidden sm:table-cell">Place Pts</th>
                  <th class="py-2.5 px-3 text-right">Total PTS</th>
                </tr>
              </thead>
              <tbody id="home-standings-tbody" class="divide-y divide-white/5">
                <% 
                  const activeStandings = (standingsOfficial && standingsOfficial.length > 0) ? standingsOfficial : (standingsUnofficial || []);
                  if (activeStandings.length === 0) { 
                %>
                  <tr>
                    <td colspan="7" class="py-6 text-center text-slate-500 font-mono text-xs">
                      No team standings recorded yet. When Match #1 is logged, team scores will show here immediately.
                    </td>
                  </tr>
                <% } else { %>
                  <% activeStandings.forEach((st, idx) => { 
                    const isTag = (st.team_tag === 'TAG' || (st.team_name || '').includes('TAG'));
                  %>
                    <tr class="standings-row hover:bg-white/5 transition-colors <%= isTag ? 'bg-gradient-to-r from-[#ff4e00]/20 via-[#ff4e00]/10 to-transparent font-bold border-l-2 border-[#ff4e00]' : '' %>"
                        data-team-id="<%= st.team_id %>">
                      <td class="py-2.5 px-3 font-display text-sm <%= idx === 0 ? 'text-amber-400' : (idx === 1 ? 'text-slate-300' : (idx === 2 ? 'text-amber-600' : 'text-slate-400')) %>">
                        #<%= idx + 1 %>
                      </td>
                      <td class="py-2.5 px-3">
                        <div class="flex items-center gap-2">
                          <img src="<%= st.team_logo %>" alt="<%= st.team_name %>" class="w-6 h-6 rounded object-cover border border-white/10 shrink-0" onerror="this.src='https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=100&auto=format&fit=crop'">
                          <div class="truncate max-w-[140px] sm:max-w-[200px]">
                            <span class="text-white font-bold <%= isTag ? 'text-orange-400' : '' %>"><%= st.team_name %></span>
                            <span class="text-[10px] text-slate-400 ml-1">(<%= st.team_tag %>)</span>
                          </div>
                        </div>
                      </td>
                      <td class="py-2.5 px-2 text-center text-slate-300"><%= st.matches_played %></td>
                      <td class="py-2.5 px-2 text-center text-amber-400 font-bold"><%= st.booyahs %></td>
                      <td class="py-2.5 px-2 text-center text-red-400"><%= st.total_kills || st.kill_points %></td>
                      <td class="py-2.5 px-2 text-center text-slate-400 hidden sm:table-cell"><%= st.placement_points %></td>
                      <td class="py-2.5 px-3 text-right font-display text-sm font-bold <%= isTag ? 'text-orange-400' : 'text-white' %>">
                        <%= st.total_points %> <span class="text-[10px] font-normal text-slate-500">PTS</span>
                      </td>
                    </tr>
                  <% }); %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Action CTA Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a href="/tournament/<%= currentTournament.id %>" class="btn-fire">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
            View Full Tournament Hub
          </a>
          <a href="/analysis#map-analysis" class="btn-glass text-slate-300 hover:text-emerald-400">
            <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/>
            </svg>
            Map Analysis
          </a>
          <a href="#matches-feed-container" class="btn-glass">
            <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
            Jump to Match Results
          </a>
        </div>

      </div>
    </section>
  <% } else { %>
    <section class="glass-panel p-8 text-center space-y-4 border-dashed border-white/20">
      <div class="w-14 h-14 rounded-2xl bg-orange-500/20 text-orange-400 mx-auto flex items-center justify-center border border-orange-500/30">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
      </div>
      <div class="space-y-1">
        <h2 class="font-display text-3xl font-bold text-white">Upcoming Season — Tournament Schedule</h2>
        <p class="text-xs text-slate-400 max-w-md mx-auto">No live ongoing tournament currently broadcasted. Browse all tournament archives and team rosters below.</p>
      </div>
      <div class="flex items-center justify-center gap-3 pt-2">
        <a href="/tournaments" class="btn-fire text-xs py-2.5 px-5">
          Browse Tournaments
        </a>
        <a href="/history" class="btn-glass text-xs py-2.5 px-5">
          Match History (1–6)
        </a>
      </div>
    </section>
  <% } %>

  <!-- ========================================================================= -->
  <!-- 4. MATCH RESULTS & MAPS + TOP PLAYERS                                      -->
  <!-- ========================================================================= -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- MATCH RESULTS LIST -->
    <div class="lg:col-span-2 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-center gap-2">
          <h3 class="font-display text-2xl font-bold text-white tracking-wide">Match Results & Maps</h3>
          <span id="match-count-badge" class="px-2 py-0.5 rounded-md text-xs font-mono bg-white/5 text-gray-300 border border-white/10">
            <%= officialMatches.length %> Matches
          </span>
        </div>
        <div class="flex items-center gap-2">
          <button type="button" onclick="toggleHomeTotalPoints()" class="btn-glass text-xs py-1.5 px-3 flex items-center gap-1.5 text-amber-400 border-amber-500/30 hover:bg-amber-500/10">
            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
            <span>Calculate Total Points</span>
          </button>
          <span id="match-filter-indicator" class="badge-official text-[10px]">OFFICIAL MATCHES</span>
        </div>
      </div>

      <!-- Live All-Matches Total Points Calculated Card (Collapsible) -->
      <div id="home-total-points-card" class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-orange-500/20 via-amber-500/15 to-orange-500/20 border border-orange-500/40 shadow-xl space-y-3 hidden">
        <div class="flex items-center justify-between border-b border-white/10 pb-2">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse"></span>
            <span class="font-display text-sm font-bold text-white uppercase tracking-wider">All Matches Total Points Summary</span>
          </div>
          <button type="button" onclick="toggleHomeTotalPoints()" class="text-xs font-mono text-slate-400 hover:text-white">✕ Close</button>
        </div>

        <% 
          let homeAllMatches = matches || [];
          let homeSumKills = 0;
          let homeSumPlacePts = 0;
          let homeSumBooyahs = 0;

          homeAllMatches.forEach(m => {
            if (m.results && m.results.length > 0) {
              const tagRes = m.results.find(r => (r.team_tag === 'TAG' || (r.team_name || '').includes('TAG'))) || m.results[0];
              if (tagRes) {
                homeSumKills += (tagRes.kills || 0);
                homeSumPlacePts += (tagRes.placement_points || 0);
                if (tagRes.placement === 1) homeSumBooyahs++;
              }
            }
          });
          const homeGrandTotalPts = homeSumKills + homeSumPlacePts;
        %>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 font-mono text-xs text-center">
          <div class="p-2.5 rounded-xl bg-black/40 border border-white/10">
            <div class="text-[10px] text-slate-400 uppercase">Matches Logged</div>
            <div class="text-lg font-bold text-white"><%= homeAllMatches.length %></div>
          </div>
          <div class="p-2.5 rounded-xl bg-black/40 border border-white/10">
            <div class="text-[10px] text-slate-400 uppercase">Position Points</div>
            <div class="text-lg font-bold text-emerald-400"><%= homeSumPlacePts %> PTS</div>
          </div>
          <div class="p-2.5 rounded-xl bg-black/40 border border-white/10">
            <div class="text-[10px] text-slate-400 uppercase">Kill Points</div>
            <div class="text-lg font-bold text-red-400"><%= homeSumKills %> PTS</div>
          </div>
          <div class="p-2.5 rounded-xl bg-gradient-to-r from-orange-500/30 to-amber-500/30 border border-orange-500/50">
            <div class="text-[10px] text-orange-300 uppercase font-bold">Total Points</div>
            <div class="text-xl font-bold text-orange-400"><%= homeGrandTotalPts %> PTS</div>
          </div>
        </div>
      </div>

      <!-- No matches state -->
      <div id="no-matches-message" class="glass-card p-8 text-center text-gray-400 <%= matches.length === 0 ? '' : 'hidden' %>">
        <p class="font-mono text-sm">No matches logged yet (0 Matches). Ready to record fresh esports results.</p>
      </div>

      <!-- Match Cards Container -->
      <div class="space-y-4" id="matches-feed-container">
        <% matches.forEach(match => { %>
          <div 
            class="match-card glass-card p-5 border-l-4 <%= match.is_official ? 'border-l-emerald-500' : 'border-l-amber-500' %> transition-all duration-300"
            data-is-official="<%= match.is_official ? 'true' : 'false' %>">
            
            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-white/5 pb-3 mb-3">
              <div class="flex items-center gap-3">
                <span class="font-display text-2xl font-bold text-white">MATCH #<%= match.match_number %></span>
                <span class="px-2.5 py-0.5 rounded-md bg-white/5 font-mono text-xs text-gray-300 border border-white/5 flex items-center gap-1.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-orange-400"></span>
                  Map: <%= match.map_name %>
                </span>
              </div>

              <div class="flex items-center gap-3">
                <% if (match.is_official) { %>
                  <span class="badge-official">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    OFFICIAL TOURNAMENT
                  </span>
                <% } else { %>
                  <span class="badge-unofficial">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    LOCAL ORGANIZER
                  </span>
                <% } %>
              </div>
            </div>

            <% if (match.notes) { %>
              <p class="text-xs text-gray-400 mb-3 italic"><%= match.notes %></p>
            <% } %>

            <!-- Match Team Placement Grid: Position, Position Points, Kill Points & Total Points -->
            <% if (match.results && match.results.length > 0) { %>
              <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2.5 text-xs font-mono">
                <% match.results.forEach(res => { 
                  const isTagTeam = (res.team_tag === 'TAG' || (res.team_name || '').includes('TAG'));
                %>
                  <div class="p-3 rounded-xl <%= res.placement === 1 ? 'bg-amber-500/15 border border-amber-500/40' : (isTagTeam ? 'bg-orange-500/15 border border-orange-500/30' : 'bg-black/35 border border-white/5') %> space-y-1.5">
                    
                    <div class="flex items-center justify-between gap-1">
                      <div class="flex items-center gap-1.5 truncate">
                        <span class="font-bold <%= res.placement === 1 ? 'text-amber-400' : 'text-slate-400' %>">
                          #<%= res.placement %> <%= res.placement === 1 ? '🏆 Booyah' : '' %>
                        </span>
                        <span class="font-semibold text-white truncate"><%= res.team_name %></span>
                      </div>
                      <span class="font-display text-sm font-bold text-orange-400 shrink-0">
                        <%= res.total_points %> PTS
                      </span>
                    </div>

                    <!-- Kill Points & Position Points Breakdown -->
                    <div class="flex items-center justify-between text-[11px] pt-1 border-t border-white/5 text-slate-400">
                      <span>Kills: <strong class="text-red-400"><%= res.kills %></strong></span>
                      <span>Place PTS: <strong class="text-emerald-400"><%= res.placement_points %></strong></span>
                      <span>Total: <strong class="text-white"><%= res.total_points %></strong></span>
                    </div>

                  </div>
                <% }); %>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>

    <!-- TOP FRAGGERS & MVP SPOTLIGHT (UPDATES TO ACTIVE MODE) -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="font-display text-2xl font-bold text-white tracking-wide">Top Fraggers (MVP)</h3>
        <span id="top-players-badge" class="badge-official text-[10px]">OFFICIAL</span>
      </div>
      
      <div class="glass-panel p-5 space-y-4" id="top-players-container">
        
        <!-- Rendered Top Player Cards -->
        <% allPlayerStats.forEach((p, idx) => { %>
          <div 
            class="top-player-row flex items-center justify-between p-3 rounded-xl bg-black/30 border border-white/5 hover:border-[#ff4e00]/30 transition-all"
            data-official-kills="<%= p.official.kills %>"
            data-official-matches="<%= p.official.matches_played %>"
            data-unofficial-kills="<%= p.unofficial.kills %>"
            data-unofficial-matches="<%= p.unofficial.matches_played %>"
            data-combined-kills="<%= p.combined.kills %>"
            data-combined-matches="<%= p.combined.matches_played %>">
            
            <div class="flex items-center gap-3">
              <span class="player-rank-num font-display text-xl font-bold <%= idx === 0 ? 'text-amber-400' : 'text-gray-600' %>">
                #<%= idx + 1 %>
              </span>
              <img src="<%= p.avatar_url %>" alt="<%= p.in_game_name %>" class="w-10 h-10 rounded-full object-cover border border-white/10" onerror="this.src='https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?q=80&w=300&auto=format&fit=crop'">
              <div>
                <a href="/player/<%= p.player_id %>" class="font-bold text-sm text-white hover:text-[#ff4e00] transition-colors block">
                  <%= p.in_game_name %>
                </a>
                <p class="text-xs text-gray-400 font-mono"><%= p.role || 'Player' %></p>
              </div>
            </div>

            <div class="text-right font-mono">
              <div class="player-kills-val text-base font-bold text-[#ff4e00]"><%= p.official.kills %> Kills</div>
              <div class="player-matches-val text-[10px] text-gray-500"><%= p.official.matches_played %> Matches</div>
            </div>
          </div>
        <% }); %>

        <div class="pt-2">
          <a href="/teams" class="btn-glass w-full text-center text-xs py-2.5 justify-center flex items-center gap-2">
            <span>View Complete Squad Profiles</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
          </a>
        </div>
      </div>
    </div>

  </div>

</main>

<!-- Inject Server Stats JSON for smooth client transitions -->
<script id="server-stats-data" type="application/json">
  <%- JSON.stringify({
    currentTourneySummary: currentTourneySummary || null,
    careerSummary: careerSummary || null,
    currentTournament: currentTournament || null
  }) %>
</script>

<%- include('partials/footer') %>
